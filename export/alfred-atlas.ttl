n:three-positions a v:Insight ;
  rdfs:label "Tre posisjoner, ikke to spor"@nb ;
  v:shortLabel "Tre posisjoner"@nb ;
  rdfs:comment "Nøytralt spørsmål: sikker på at det ikke er noe etterpå. Sorg: vi vet ikke, og det som er sikkert, ligger i fortiden. Uttrykkelig ønske om håp: kjærligheten fortsetter, i hvis-form. Sorgen gjorde svaret mer presist, ikke mer ønsketenkende. Den fjernet en visshet som ikke var dekket, og la ikke til noen ny. Midtposisjonen ligner det kartet selv har kommet fram til."@nb ;
  v:region v:blindspots ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
