n:ryle a v:Thinker ;
  rdfs:label "Gilbert Ryle"@nb ;
  rdfs:comment "Britisk filosof som innførte begrepet kategorifeil."@nb ;
  v:region v:words ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
