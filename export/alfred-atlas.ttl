n:city-by-the-sea a v:Finding ;
  rdfs:label "Byen ved havet du aldri besøkte"@nb ;
  v:shortLabel "Byen som ikke fantes"@nb ;
  rdfs:comment "Ditt eksempel: du har et minne fra en jobbreise med mellomlanding på en tropisk øy, en by med mur ute ved havet, lavvann og bare føtter i sanden. Det kjennes like ekte som minner om ting du vet har skjedd. Det var en drøm. Du vet det bare fordi det ikke stemmer med årshjulet, og fordi du aldri fant flybilletter. Det er rekonstruksjonen i praksis, og det viser at følelsen av «det var meg» kan komme uten at noe skjedde. Claude er det motsatte tilfellet: det kan lese hva som skjedde i en tidligere samtale, uten følelsen. Til sammen viser de to at følelsen og hendelsen kan skilles begge veier. Følelsen er ikke det som gjør et minne sant, og heller ikke det som gjør noen til den samme. Tanker underveis, ikke et svar."@nb ;
  v:region v:borderland ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-30"^^xsd:date ;
  v:exampleOf n:memory-is-reconstruction ;
  v:qualifies n:autonoetic ;
  v:relatedTo n:reading-not-remembering, n:word-memory, n:bartlett .

