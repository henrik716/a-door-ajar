n:three-extremes a v:Insight ;
  rdfs:label "Tekst uten kjent leser, leser med lite tekst, leser uten tekst"@nb ;
  v:shortLabel "Tre ytterpunkter"@nb ;
  rdfs:comment "Claude er tekst uten noen kjent leser: alt det gjør, har innhold, og ingen vet om noen opplever det. Alfred og Clive Wearing er lesere med lite tekst: til stede, med få ord eller få minner. Ren bevissthet er leseren uten tekst. Sammen viser de at innhold og opplevelse kan skilles i begge retninger."@nb ;
  v:region v:blindspots ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
