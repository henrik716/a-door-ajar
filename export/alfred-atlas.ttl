n:brainstem-switch a v:Finding ;
  rdfs:label "En liten flekk i hjernestammen kan slå av alt"@nb ;
  v:shortLabel "Bryteren i hjernestammen"@nb ;
  rdfs:comment "Skader i et lite område i hjernestammen kan gi koma, og området er koblet til to bestemte steder i hjernebarken. Våkenheten har altså en egen forsyning. James ville sagt at det er radioens strømbryter. Det passer med begge synene, men det viser hvor lite som skal til."@nb ;
  v:region v:consciousness ;
  v:strength v:solid ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  dct:source "Fischer, Boes m.fl., A human brain network derived from coma-causing brainstem lesions, Neurology (2016)"@nb ;
