n:thoughts-on-series-and-ship a v:Finding ;
  rdfs:label "Rekken og skipet"@nb ;
  v:shortLabel "Tankene om rekken og skipet"@nb ;
  rdfs:comment "Dine tanker om rekken fra pause til kopi: ja til pausen, ja til hundre år i frys, ja til å settes sammen av egne deler, og ja til å bygges opp igjen av de samme atomene etter at de har vært spredt. Bare en ny hjerne bygget etter en skanning er en kopi. Om skipet: det som settes sammen av de gamle plankene, er lettest å se som skipet, og det som er byttet ut gradvis, er også skipet. Men byttes alt ut på en gang, er det ikke det lenger, og det er rart når utfallet er det samme. Du la til at det kanskje bare er følelser som gjør det slik. Tanker underveis, ikke et svar."@nb ;
  v:region v:self ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  v:answers n:pause-or-copy ;
  v:relatedTo n:lit-by-him, n:origin-matters, n:hobbes-planks, n:your-thoughts-on-carrier ;
  v:leadsTo n:the-path-matters .

