n:boundary-problem a v:Question ;
  rdfs:label "Grenseproblemet"@nb ;
  rdfs:comment "Hva avgjør hvor ett sinn slutter og et annet begynner? Intuitivt svarer vi hodeskallen. Virkelige tilfeller viser at det ikke holder."@nb ;
  v:region v:limits ;
  v:answer "Åpent"@nb ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date .

n:brain-transplant a v:Question ;
  rdfs:label "Hjernen i en annen hund?"@nb ;
  rdfs:comment "Den sterkeste innvendingen mot animalismen. Hvis Alfreds hjerne ble satt inn i en annen hund, og den hunden våknet og kjente deg igjen, ville det vært ham? De fleste svarer ja, og da følger man hjernen og mønsteret, ikke dyret. Olson svarer at dyret blir igjen i den gamle kroppen. Svaret ditt viser om magefølelsen din er animalisme hele veien, eller bare så langt mønsteret ikke flytter seg."@nb ;
  v:region v:self ;
  v:answer "Ja, da ville det vært ham"@nb ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  v:challengesWord n:word-same ;
  v:relatedTo n:animalism, n:the-swap .

n:brain-wakefulness a v:Position ;
  rdfs:label "Ren bevissthet er hjernens våkenhet"@nb ;
  v:shortLabel "Hjernens våkenhet"@nb ;
  rdfs:comment "Metzingers hypotese etter å ha samlet hundrevis av beskrivelser fra mediterende: det som oppleves, er hjernens grunnleggende våkenhet, uten noe oppå. Da er ren bevissthet en tilstand i en levende hjerne, og den opphører med hjernen."@nb ;
  v:region v:consciousness ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Metzinger (2020), Philosophy and the Mind Sciences"@nb ;
  dct:source "Metzinger (2024), The Elephant and the Blind"@nb ;
  v:answers n:words-are-layers ;
  v:relatedTo n:pure-awareness ;
  v:supports n:materialism .

