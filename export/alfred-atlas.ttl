n:different-now a v:Insight ;
  rdfs:label "Alfred levde i et annet nå"@nb ;
  rdfs:comment "Gjennom øynene i et mer finmasket nå, gjennom nesa i et nå tykt av det som nettopp hadde vært. Det taler for at nået hører til den som opplever, ikke til verden."@nb ;
  v:region v:time ;
