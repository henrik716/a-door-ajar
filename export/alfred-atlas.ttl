n:russell a v:Thinker ;
  rdfs:label "Bertrand Russell"@nb ;
  rdfs:comment "Britisk filosof."@nb ;
  v:region v:consciousness ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "The Analysis of Matter (1927)"@nb ;
