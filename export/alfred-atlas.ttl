n:dying-fire a v:Image ;
  rdfs:label "Bålet som slukner"@nb ;
  rdfs:comment "En mann spør Buddha hvor en opplyst person går etter døden. Buddha spør tilbake hvilken retning ilden går når bålet slukner. «Hvor» passer ikke, og «ingensteds» avviste han også. Noen forskere mener ilden ble forstått som frigjort fra veden, ikke tilintetgjort."@nb ;
  v:region v:words ;
  v:strength v:image ;
  v:conversation v:deepdive ;
