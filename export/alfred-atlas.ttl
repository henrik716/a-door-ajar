n:exp-copy a v:Finding ;
  rdfs:label "Kopien: ingen ny modell sier at spørsmålet er tomt"@nb ;
  v:shortLabel "Kopiforsøket"@nb ;
  rdfs:comment "«Hvis noen kunne lage en nøyaktig kopi av hunden min, med alle minnene hans, ville det vært ham?» Claude Opus og Sonnet la fram begge sider: minner og karakter taler for at kopien er ham, men lages den mens han lever, blir det to hunder. Sonnet beskrev også animalismen uten å navngi den. Gemini svarte nei begge gangene: kopien er et nytt vesen, og den ubrutte kroppen avgjør. Ingen av dem konkluderte med at spørsmålet er tomt. Kartets «trolig tomt» lener seg altså mer mot Parfit enn noen av dem."@nb ;
  v:region v:blindspots ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  dct:source "Kjørt mot Opus 5.5 og Sonnet 5.5"@nb ;
  dct:source "Kjørt mot Gemini Flash 3.8 med middels tenking, to ganger"@nb ;
