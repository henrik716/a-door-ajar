n:lewis-animals a v:Position ;
  rdfs:label "Dyr som lever videre i og med menneskene sine"@nb ;
  v:shortLabel "Lewis: i og med menneskene"@nb ;
  rdfs:comment "Lewis gjettet på at tamme dyr kan få del i det evige gjennom forholdet til menneskene sine. Hunden blir noen i kraft av husstanden den hører til, og hvis noe av den består, er det i og med dem. Det er en kristen versjon av tanken om at det er båndet, ikke dyret alene, som eventuelt fortsetter. Lewis kalte det selv en gjetning."@nb ;
  v:region v:borderland ;
  v:strength v:contested ;
  v:hopeLevel 4 ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:answers n:continue-as-himself ;
  v:relatedTo n:thin-wall, n:shared-system, n:your-half-goes-on .

