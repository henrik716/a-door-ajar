n:extended-mind a v:Position ;
  rdfs:label "Ottos notatbok"@nb ;
  rdfs:comment "Clark og Chalmers tenkte seg Otto, som har Alzheimers og skriver alt i en notatbok. De mente at notatboka er en del av hukommelsen hans. Claudes notater er en slik notatbok. Videoene og det du tok vare på av Alfred, er det også: sporene kan ligge utenfor hjernen. Men notatboka husker ingenting selv. Den trenger en leser."@nb ;
  v:region v:borderland ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Clark og Chalmers (1998), The Extended Mind, Analysis"@nb ;
  v:qualifies n:t-memory-without-brain ;
  v:relatedTo n:relation-r-in-notes, n:reading-not-remembering ;
  v:leadsTo n:reader-is-the-question .

n:eyebrow-muscle a v:Finding ;
  rdfs:label "Muskelen over øynene"@nb ;
  rdfs:comment "Hunder har utviklet en egen muskel over øynene som gjør blikket lettere for oss å lese."@nb ;
  v:region v:dog ;
  v:strength v:solid ;
  v:conversation v:deepdive ;
