n:cosmic-copies a v:Position ;
  rdfs:label "Kopier i et uendelig univers"@nb ;
  v:shortLabel "Kosmiske kopier"@nb ;
  rdfs:comment "Hvis rommet er uendelig, finnes kopier av alt et sted langt ute. Det hjelper ikke: en tilfeldig kopi har ingen årsakssammenheng med Alfred."@nb ;
