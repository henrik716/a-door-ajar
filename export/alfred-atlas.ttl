n:middle-way a v:Position ;
  rdfs:label "Midtveien: verken evig eller utslettet"@nb ;
  v:shortLabel "Midtveien"@nb ;
  rdfs:comment "Buddhismen regner to syn som like feil: at et selv lever evig videre, og at alt bare blir utslettet. Det siste har sitt eget navn, utslettelsessynet, og regnes som en feiltakelse på linje med det første. «Han er bare borte» er altså ikke det nøkterne standpunktet her. Det er den ene av to feil."@nb ;
  v:region v:east ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:contradicts n:simply-gone, n:soul-continues ;
  v:leadsTo n:nothing-is-a-wrong-word .

n:middle-way-on-the-map a v:Insight ;
  rdfs:label "Midtveien: vissheten falt begge veier"@nb ;
  v:shortLabel "Midtveien"@nb ;
  rdfs:comment "Verken den lette trøsten eller den lette fortvilelsen holdt. De mest motsagte stedene i kartet er de to ytterpunktene og de skjulte antakelsene de hviler på: sjelen forutsetter et dypt selv og minner uten hjerne, og «han er bare borte, punktum» forutsetter et felles nå og at hvert sinn er forseglet. Det som falt, er vissheten begge veier. Men sannsynlighetene veier ikke likt. Gitt det vanlige synet at hjernen lager opplevelsen, taler langt mer for at opplevelsen hans tok slutt. Gitt at hjernen tar imot den, er det åpent. Midtveien kan også delvis komme av mønstersynet og av feil ord-grepet."@nb ;
  v:region v:core ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:supports n:middle-way ;
  v:relatedTo n:soul-continues, n:simply-gone, n:nothing-is-a-wrong-word, n:middle-way ;
  v:presupposes n:materialism, n:questions-can-dissolve ;
  v:contradicts n:simply-gone .

