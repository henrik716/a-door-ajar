n:neurophenomenology a v:Position ;
  rdfs:label "Se innover, presist"@nb ;
  rdfs:comment "I flere tiår ble opplevelse innenfra holdt utenfor psykologien. Varela foreslo å trene folk til å observere sin egen opplevelse presist, og koble det med målinger av hjernen. Det eneste stedet du selv kan lete, uten mellomledd."@nb ;
  v:region v:consciousness ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
