n:buddha a v:Thinker ;
  rdfs:label "Buddha"@nb ;
  rdfs:comment "For omkring 2500 år siden. La noen spørsmål til side uten svar, blant dem hva som skjer med den opplyste etter døden. Lærte at selvet er en prosess, og at både evig liv og utslettelse er feil syn."@nb ;
  v:region v:east ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Cula-Malunkyovada-sutta (Majjhima Nikaya 63)"@nb ;
  dct:source "Aggivacchagotta-sutta (Majjhima Nikaya 72)"@nb ;
