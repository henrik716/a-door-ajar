n:bodily-resurrection a v:Position ;
  rdfs:label "Kroppens oppstandelse"@nb ;
  rdfs:comment "I kristen tro er håpet ikke en sjel som flyr bort, men at hele mennesket reises opp igjen. Filosofisk er det en versjon av gjensamlingen, med Gud som den som samler. Van Inwagen pekte på at den møter samme problem som all gjensamling: er det den samme, eller en kopi?"@nb ;
  v:region v:borderland ;
  v:strength v:contested ;
  v:hopeLevel 6 ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
