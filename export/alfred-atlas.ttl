n:fly-in-the-bottle a v:Image ;
  rdfs:label "Fluen i flaska"@nb ;
  rdfs:comment "Wittgenstein sa at målet med filosofien er å vise fluen veien ut av fluefangerflaska. Fluen kommer seg ikke ut fordi den flyr mot glasset. Veien ut er der den kom inn."@nb ;
  v:region v:words ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
