n:lamp-lit-by-lamp a v:Image ;
  rdfs:label "En lampe tent av en annen"@nb ;
  v:shortLabel "Lampe tent av lampe"@nb ;
  rdfs:comment "Kong Milinda spør hvordan noen kan gjenfødes uten at noe flytter over. Nagasena svarer med en mann som tenner én lampe fra en annen. Ingenting går over fra den ene lampen til den andre, men den nye flammen er ikke uten forbindelse med den gamle. Det er nær det skillet du trekker: en flamme tent av ham, ikke en ny flamme med samme form."@nb ;
  v:region v:east ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  dct:source "Milindapañha (Kong Milindas spørsmål)"@nb ;
