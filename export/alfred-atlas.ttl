  v:relatedTo n:hard-problem .

n:view-from-nowhere a v:Position ;
  rdfs:label "Blikket fra ingensteds"@nb ;
  rdfs:comment "Den objektive beskrivelsen utelater nøyaktig det stedet den er sett fra. Jeg, her og nå finnes ikke i den."@nb ;
  v:region v:consciousness ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:leadsTo n:three-words-physics-lacks .

n:voice-areas a v:Finding ;
  rdfs:label "Stemmeområdene"@nb ;
  rdfs:comment "Hundehjernen har områder som reagerer på stemmer, slik vår gjør, og som fanger opp følelsen i tonen. At Alfred kjente igjen stemmen din, var en ekte funksjon i hjernen hans."@nb ;
  v:region v:dog ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Andics mfl. (2014), Current Biology"@nb ;
  v:relatedTo n:scent-of-you, n:ability-not-archive .

n:waiting-time a v:Finding ;
  rdfs:label "Hunder merker hvor lenge de var alene"@nb ;
  v:shortLabel "Ventetiden"@nb ;
  rdfs:comment "Hunder som ble alene hjemme, hilste eieren kraftigere etter to timer enn etter en halv. Men mellom to og fire timer var det ingen forskjell. De merker tid, men kanskje ikke som en strekning som bare blir lengre og lengre."@nb ;
  v:region v:dog ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Rehn og Keeling (2011), Applied Animal Behaviour Science"@nb ;
  v:answers n:alfreds-own-side ;
  v:qualifies n:alfred-at-the-door .

n:wegner a v:Thinker ;
  rdfs:label "Daniel Wegner"@nb ;
  rdfs:comment "Amerikansk psykolog (1948–2013)."@nb ;
  v:region v:grief ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:behind n:transactive-memory .

n:what-died-for-you a v:Question ;
  rdfs:label "Hva døde for deg?"@nb ;
  rdfs:comment "Når et dyr man har levd med så lenge dør, mister man også den versjonen av seg selv som fantes sammen med ham: han som gikk de tidlige turene, og han som ble ventet på."@nb ;
  v:region v:grief ;
  v:answer "Også en del av deg"@nb ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:relatedTo n:transactive-memory, n:your-half-goes-on, n:self-other-overlap .

n:what-hope-requires a v:Position ;
  rdfs:label "Hva håp krever"@nb ;
  rdfs:comment "Martin: å håpe krever at man ønsker noe og ser det som mulig, ikke som sannsynlig. Da kan håp være ærlig selv når sjansen er liten, så lenge man ikke later som den er større. Hele håpsstigen i kartet hviler på dette. Kant stilte det som et av filosofiens tre store spørsmål: Hva kan jeg håpe?"@nb ;
  v:region v:core ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:relatedTo n:not-ruled-out-has-content, n:less-of-him, n:intuition-not-proof .

n:what-level-5-requires a v:Insight ;
  rdfs:label "Hva hans egen strøm krever"@nb ;
  v:shortLabel "Det nivå 5 krever"@nb ;
  rdfs:comment "For at hans egen strøm skal fortsette uten minnene, må tre ting stemme. Opplevelsen kan ikke bare lages av hjernen. Det individuelle må sitte i selve strømmen, ikke i innholdet. Og noe må bære strømmen videre når hjernen opphører, tent av ham og ikke laget etter ham. Det første er åpent. Det andre er omstridt, og det beste vi vet om opplevelse uten innhold peker mot nei. Det tredje er det vanskeligste: synene som tåler fysikken, lar strømmen løses opp med hjernen, og de som lar den fortsette, trenger noe fysikken presser."@nb ;
  v:region v:core ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:hopeLevel 5 ;
  v:status v:frontier ;
  v:conversation v:deepdive ;
  dct:created "2026-10-30"^^xsd:date ;
  v:presupposes n:t-inside-extra, n:mineness, n:lit-by-him ;
  v:relatedTo n:three-receptions, n:closed-physics, n:where-the-individual-sits .

n:what-was-the-carrier a v:Insight ;
  rdfs:label "Hva var bæreren?"@nb ;
  v:shortLabel "Hva var bæreren?"@nb ;
  rdfs:comment "Bærersynet tar bort kopiene og kroppen og legger vekten på ett spørsmål, som egentlig er to. Hva som bærer ham, altså minnene, vanene og måten han kjente deg igjen på, er godt kjent: det er hjernen, og funnene er solide. Hva som bærer opplevelsen, er åpent, for det er det harde problemet. Var bæreren hjernen, sluknet flammen da hjernen stoppet, og ingen kopi tenner den igjen. Var hjernen et filter for opplevelsen, kan noe ha fortsatt, men ikke nødvendigvis med minnene. Skillet mellom de to bærerne forutsetter at han måles i innhold. Er vi bare informasjon, burde vi kunne settes sammen igjen, og fysikken sier at informasjonen i prinsippet ikke går tapt. Men det gir ham bare tilbake hvis man også slipper linjen din: under den er en gjensamling etter en beskrivelse en kopi."@nb ;
  v:region v:core ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  v:presupposes n:carrier-view, n:t-content ;
  v:relatedTo n:hard-problem, n:filter-theory, n:animalism-polarizes, n:flame-through-the-night, n:less-of-him, n:paradoxical-lucidity, n:information-preserved, n:line-closes-third-way .

n:where-does-the-fist-go a v:Image ;
  rdfs:label "Hvor går knyttneven?"@nb ;
  rdfs:comment "Når du åpner hånda, har knyttneven ikke gått noe sted. Den var en måte hånda var ordnet på. Det samme med fanget når du reiser deg."@nb ;
  v:region v:words ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:exampleOf n:category-mistake .

n:where-is-the-chariot a v:Image ;
  rdfs:label "Hvor er vognen?"@nb ;
  rdfs:comment "Nagasena spør kongen om vognen er hjulene, akslingen eller setet. Den er ingen av delene, og heller ikke noe utenfor dem. «Vogn» er et navn på hvordan delene henger sammen. Det samme poenget som Ryles universitet, to tusen år før."@nb ;
  v:region v:east ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:exampleOf n:category-mistake ;
  v:relatedTo n:where-is-the-university .

n:where-is-the-university a v:Image ;
  rdfs:label "Hvor er universitetet?"@nb ;
  rdfs:comment "Ryles besøkende har sett forelesningssaler, bibliotek og laboratorier, og spør så hvor universitetet er. Han leter etter en ting til der det bare finnes en ordning."@nb ;
  v:region v:words ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:exampleOf n:category-mistake .

n:where-the-individual-sits a v:Insight ;
  rdfs:label "Hvor sitter det som gjør lytteren til hans?"@nb ;
  v:shortLabel "Hvor individet sitter"@nb ;
  rdfs:comment "Spørsmålet om det fantes en lytter som var hans, avhenger av hvor det individuelle sitter. Sitter det i selve lytteren, slik Zahavi og buddhismens strøm sier, var lytteren hans helt inn, og kunne den fortsette, ville den vært ham. Sitter det i innholdet og selvmodellen, slik Metzinger, Advaita og Kastrup sier, var lytteren aldri bare hans, og det som eventuelt fortsetter, er havet. Kastrups bilde åpner for at vannet blir med. For en hund er spørsmålet ekstra skarpt, men på en annen måte enn kartet først skrev. Alfred hadde trolig lite av det fortellende selvet, historien om seg selv, men trolig det minimale: å være noen, et sted, i en kropp. Sitter det individuelle i fortellingen, var grensen mellom ham og havet tynnere hos ham. Sitter det i kjernen av selvmodellen, som er kroppslig, var den ikke nødvendigvis det."@nb ;
  v:region v:core ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:status v:frontier ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  dct:modified "2026-11-03"^^xsd:date ;
  v:change [ dct:date "2026-11-03"^^xsd:date ; rdfs:comment "Den siste setningen rettet etter gravingen om selvet hos en hund. Det tynne hos Alfred var trolig fortellingen, ikke hele selvmodellen, så grensen mot havet var ikke nødvendigvis tynnere hos ham."@nb ; v:changedField "text" ] ;
  v:answers n:his-own-listener ;
  v:relatedTo n:three-receptions, n:alfreds-three-words, n:thin-wall, n:measured-by-content .

# note: n:where-the-individual-sits v:answers n:his-own-listener — avhenger av hvor det individuelle sitter
n:whitehead a v:Thinker ;
  rdfs:label "Alfred North Whitehead"@nb ;
  rdfs:comment "Matematiker og filosof. Grunnla prosessfilosofien."@nb ;
  v:region v:time ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
