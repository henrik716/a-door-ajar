n:frame-picks-intuition a v:Finding ;
  rdfs:label "Samme tilfelle, motsatt magefølelse"@nb ;
  v:shortLabel "Rammen velger magefølelsen"@nb ;
  rdfs:comment "Williams beskrev ett og samme tankeeksperiment på to måter. Fortalt som et bytte av kropper følger folk minnene. Fortalt som at du skal pines i morgen, men først miste minnene dine, følger folk kroppen. Magefølelsen om identitet skifter med hvordan tilfellet fortelles. At dine svar spriker litt, er derfor ikke en feil hos deg, men det vanlige."@nb ;
  v:region v:blindspots ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  dct:source "Bernard Williams, The Self and the Future (1970)"@nb ;
  v:qualifies n:your-thoughts-on-carrier ;
  v:relatedTo n:grief-picks-the-theory, n:claude-test-both-tracks .

