n:track-trap a v:Insight ;
  rdfs:label "Et spor blir fort til «sånn er det»"@nb ;
  v:shortLabel "Sporfella"@nb ;
  rdfs:comment "Din observasjon: vi har flere ganger fulgt et spor og sagt «sånn er det» uten å sjekke det mot andre vinkler. Det skjedde med Parfit, og med målet på hvor mye av ham noe bærer. Grepet mot det er å skrive ut antakelsene som egne steder og koble slutningene til dem. Da viser reglene i kartet selv hva som utfordres når en antakelse blir motsagt."@nb ;
  v:region v:blindspots ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  v:relatedTo n:load-bearing-parfit, n:grief-picks-the-theory, n:measured-by-content, n:atlas-projection ;
  v:exampleOf n:t-content .

n:tradeoff a v:Insight ;
  rdfs:label "Du får ikke begge deler fullt ut"@nb ;
  v:shortLabel "Ikke begge deler fullt ut"@nb ;
  rdfs:comment "Enten er innsiden mønsteret, og da lever han delvis i deg, men det finnes ikke noe mer som kan være et annet sted. Eller er innsiden mer enn mønsteret, og da er den ikke i deg, men hva som skjer med den, er ukjent. Den svake versjonen av mønsteret står i begge grenene."@nb ;
  v:region v:consciousness ;
