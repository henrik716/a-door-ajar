  v:behind n:introspection-unreliable .

n:secure-base a v:Finding ;
  rdfs:label "Du var den trygge basen"@nb ;
  rdfs:comment "Med metodene fra forskning på små barn og foreldre: hunder knytter seg til mennesket sitt som en trygg base. Når personen er der, utforsker de roligere. Når personen går, merker de det i hele kroppen."@nb ;
  v:region v:dog ;
  v:strength v:solid ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Topál mfl. (1998), Journal of Comparative Psychology"@nb ;
  v:supports n:thin-wall .

n:self-as-agent a v:Position ;
  rdfs:label "Vi må være én for å kunne handle"@nb ;
  v:shortLabel "Selvet som handlende"@nb ;
  rdfs:comment "Korsgaards svar til Parfit: selv om det ikke finnes noen dyp kjerne, må et vesen som handler, se seg selv som én gjennom tiden. Den som tar et valg i dag, må bære det i morgen. Enheten er ikke et faktum vi finner, men noe vi må gjøre oss til for å kunne leve. For Alfred, som ikke la planer for fremtiden, gjelder det kanskje mindre enn for oss."@nb ;
  v:region v:self ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  dct:source "Christine Korsgaard, Personal Identity and the Unity of Agency: A Kantian Response to Parfit (1989)"@nb ;
  v:qualifies n:reductionism ;
  v:relatedTo n:mental-time-travel .

# note: n:self-as-agent v:qualifies n:reductionism — enheten er praktisk, ikke metafysisk
n:self-other-overlap a v:Finding ;
  rdfs:label "Selv-andre-overlapp"@nb ;
  rdfs:comment "I nære relasjoner tar vi den andre inn i vårt eget selvbilde. Folk bruker lengre tid på å skille sine egne egenskaper fra partnerens, fordi grensen er blitt utydelig. Senere forsøk fant at folk oftere blander sammen hva de har sagt om seg selv og om en nær person, og at det skyldes nærheten, ikke likhet eller at de kjenner personen godt. Funnene gjelder mennesker seg imellom. Mellom menneske og hund er det ikke målt."@nb ;
  v:region v:limits ;
  v:strength v:solid ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:modified "2026-11-04"^^xsd:date ;
  v:change [ dct:date "2026-11-04"^^xsd:date ; rdfs:comment "Fant kilder. La til at funnet gjelder mennesker, siden det støtter veggen mellom deg og Alfred."@nb ; v:changedField "text", "sources", "links" ] ;
  dct:source "Aron, Aron, Tudor og Nelson, Close relationships as including other in the self, Journal of Personality and Social Psychology 60 (1991)"@nb ;
  dct:source "Debra Mashek, Arthur Aron og Maria Boncimino, Confusions of Self With Close Others, Personality and Social Psychology Bulletin 29 (2003)"@nb ;
  v:supports n:thin-wall, n:grief-and-self-concept .

# note: n:self-other-overlap v:supports n:thin-wall — målt mellom mennesker, ikke mellom menneske og hund
n:self-questions-for-a-dog a v:Question ;
  rdfs:label "Gjelder spørsmålene om selvet for en hund?"@nb ;
  v:shortLabel "Selvet hos en hund"@nb ;
  rdfs:comment "Mye av gravingen om hvem som eventuelt fortsetter, bygger på tilfeller tenkt ut for mennesker: Locke og minnene, Parfit og teleporteren, kopien og opphavet. Antakelsen under, som ikke står skrevet noe sted, er at de samme spørsmålene gjelder for en hund på samme måte. Det er ikke sikkert. Alfred husket hendelser, men levde mest i et bredt nå, trolig uten en fortelling om seg selv, og verden hans var mest lukt og kropp. Var selvet hans tynnere eller bygget annerledes, kan svarene flytte seg: kanskje veier kroppen og opphavet mer for ham, og minnene og selvmodellen mindre. Kartet har funnet at modellene gir et menneske mer rom for tro enn en hund. Det samme kan gjelde for hvor kartet selv har gravd: få lenker fra Selvet, Bevisstheten, Kjernen og Grensene går til Alfreds verden. Gravd første gang 3. november. Locke ga selv minnekriteriet bare til personer, og for dyr sa han at det er det samme livet som teller. Skillet mellom et minimalt og et fortellende selv viser at det som var tynt hos Alfred, trolig var fortellingen, ikke selvet. Tankeforsøkene om minner og sammenhenger treffer ham derfor svakere, mens de om opphavet og den ubrutte veien gjelder fullt ut. McMahan viser at spørsmålet også handler om hva han mistet, ikke bare om hvem som eventuelt fortsetter. Åpent: hva dette flytter i svarene om bæreren og om havet."@nb ;
  v:region v:dog ;
  v:status v:frontier ;
  v:answer "Delvis: minnene treffer ham svakere, opphavet like sterkt"@nb ;
  v:conversation v:map ;
  dct:created "2026-11-03"^^xsd:date ;
  dct:modified "2026-11-03"^^xsd:date ;
  v:change [ dct:date "2026-11-03"^^xsd:date ; rdfs:comment "Gravd første gang: Locke om dyr, de to lagene i selvet, kroppen som hinder og McMahans tidsrelative interesser. Fra ikke gravd til fronten."@nb ; v:changedField "status", "answer", "text" ] ;
  v:relatedTo n:where-the-individual-sits, n:good-enough-carrier, n:load-bearing-parfit, n:t-content, n:animalism, n:mental-time-travel, n:dog-episodic-memory, n:umwelt, n:exp-human-vs-dog .

n:sensing-presence a v:Finding ;
  rdfs:label "Å kjenne nærværet"@nb ;
  rdfs:comment "Nesten halvparten av enkene og enkemennene i en klassisk studie hadde kjent nærværet av den døde, eller sett eller hørt dem. Det samme beskrives etter tap av et dyr: å høre labbene, kjenne vekten i senga. De fleste forskere ser det som hjernens kart som fortsatt forventer, og det er ikke et tegn på at noe er galt. For mange er det en trøst."@nb ;
  v:region v:grief ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Rees (1971), British Medical Journal"@nb ;
  dct:source "Packman mfl. (2012), Omega"@nb ;
  v:relatedTo n:grief-is-learning, n:inner-outer-bonds, n:lasting-bonds .

n:seth a v:Thinker ;
  rdfs:label "Anil Seth"@nb ;
  rdfs:comment "Britisk hjerneforsker ved University of Sussex."@nb ;
  v:region v:consciousness ;
  v:conversation v:map ;
  dct:created "2026-11-02"^^xsd:date ;
