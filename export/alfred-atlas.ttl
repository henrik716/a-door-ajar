n:laughter-in-grief a v:Finding ;
  rdfs:label "Latter i sorgen"@nb ;
  rdfs:comment "Ekte latter når folk fortalte om den de hadde mistet, håndet sammen med bedre tilpasning senere. Når du ler av noe Alfred gjorde, er det ikke sorgen som svikter. Det er båndet som virker."@nb ;
  v:region v:grief ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Bonanno og Keltner (1997), Journal of Abnormal Psychology"@nb ;
  v:supports n:alternation, n:lasting-bonds .

n:less-of-him a v:Insight ;
  rdfs:label "Det som står best, bærer minst av ham"@nb ;
  v:shortLabel "Jo bedre det står, jo mindre av ham"@nb ;
  rdfs:comment "Et mønster gjennom hele kartet. Det som skjedde, står solid, men ingenting av ham opplever det. Mønsteret i deg står solid, men det er din side. En innside som fortsetter, er omstridt, og selv i den håpefulle lesningen av ren bevissthet er det som fortsetter, det som ikke inneholder noe av ham. Han selv, med deg i seg, står svakest."@nb ;
  v:region v:core ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:relatedTo n:not-ruled-out-has-content, n:reassembly-stands, n:reader-is-the-question, n:awareness-as-ground ;
  v:presupposes n:t-content .

