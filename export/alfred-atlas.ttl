n:frankl a v:Thinker ;
  rdfs:label "Viktor Frankl"@nb ;
  rdfs:comment "Østerriksk psykiater og nevrolog (1905–1997). Overlevde flere konsentrasjonsleirer. Faren døde i Theresienstadt, moren og broren i Auschwitz, og kona Tilly i Bergen-Belsen. Bygde mye av trøsten sin på at det som har vært, ikke kan tas bort."@nb ;
  v:region v:grief ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
