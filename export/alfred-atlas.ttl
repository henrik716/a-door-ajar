n:schrodinger a v:Thinker ;
  rdfs:label "Erwin Schrödinger"@nb ;
  rdfs:comment "En av kvantemekanikkens fedre. Skrev at bevissthet aldri oppleves i flertall, og hentet tanken fra Upanishadene."@nb ;
  v:region v:limits ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Mind and Matter (1958)"@nb ;
  v:behind n:open-individualism .

n:schwitzgebel a v:Thinker ;
  rdfs:label "Eric Schwitzgebel"@nb ;
  rdfs:comment "Amerikansk filosof."@nb ;
  v:region v:consciousness ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
