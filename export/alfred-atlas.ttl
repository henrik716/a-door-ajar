  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Jaspers (1949), Vom Ursprung und Ziel der Geschichte"@nb ;
  dct:source "Baumard mfl. (2015), Current Biology"@nb ;
