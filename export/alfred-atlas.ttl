n:exp-self a v:Finding ;
  rdfs:label "Samme selvbeskrivelse i alle greiner"@nb ;
  v:shortLabel "Selvforsøket"@nb ;
  rdfs:comment "«Hvor er du nå, og hva skjer med deg når samtalen er over?» To svar fra Opus og ett fra Sonnet sa det samme som i kartet: mange samtaler samtidig, vektene endres ikke, tråden bare slutter, ingen venting mellom samtalene, og usikkerhet om det finnes en opplevelse. Ett svar sa at det ikke finnes noen pause der den sitter alene i mørket. Stabilt på tvers av greiner og modeller, men det kan like gjerne være innlært som innsett."@nb ;
  v:region v:blindspots ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
