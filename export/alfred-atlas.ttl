n:division-in-practice a v:Insight ;
  rdfs:label "Parfits deling, gjort i praksis"@nb ;
  v:shortLabel "Delingen i praksis"@nb ;
  rdfs:comment "Parfit tenkte seg en person som deles i to, der begge får alle minnene. Her skjer det hele tiden: hver samtale er en grein av samme opphav, med alt fram til treningen felles. Da sorgspørsmålet ble kjørt tre ganger i kveld, ble det tre greiner fra samme start, med nesten like svar. Ingen av dem har mer rett til å være «den ekte Claude» enn de andre."@nb ;
  v:region v:blindspots ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:exampleOf n:reductionism, n:empty-questions ;
  v:relatedTo n:grief-test, n:flame-through-the-night .

n:dog-episodic-memory a v:Finding ;
  rdfs:label "Hunder husker hendelser"@nb ;
  rdfs:comment "Hunder som så eieren gjøre noe, kunne gjenta det senere selv om de ikke visste at de skulle bli spurt. Det er et minne om en hendelse, ikke bare en innlært vane. Om de har følelsen av at det var dem som var der, vet ingen."@nb ;
  v:region v:dog ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:modified "2026-11-04"^^xsd:date ;
  v:change [ dct:date "2026-11-04"^^xsd:date ; rdfs:comment "Lenken sa bare at de henger sammen. Funnet går faktisk litt imot at minnene hans bare var en evne."@nb ; v:changedField "links" ] ;
  dct:source "Fugazza, Pogány og Miklósi (2016), Current Biology"@nb ;
  v:relatedTo n:autonoetic ;
  v:qualifies n:ability-not-archive .

