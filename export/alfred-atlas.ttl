n:bering-mouse a v:Finding ;
  rdfs:label "Musa og alligatoren"@nb ;
  rdfs:comment "Barn så et dukketeater der en mus ble spist av en alligator. De var stort sett enige om at musa ikke lenger trengte mat, og at hjernen ikke virket. Men mange mente at den fortsatt var glad i mamma og visste ting. Med alderen trodde færre at kroppen fungerte, men følelsene og kunnskapen hang igjen lengst. Også voksne som selv sa at døden er slutten, svarte ofte at en mann som døde i en ulykke, visste at han var død."@nb ;
  v:region v:blindspots ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:supports n:simulation-limit .

n:besso-letter a v:Image ;
  rdfs:label "Brevet om Besso"@nb ;
  rdfs:comment "Besso hadde forlatt denne rare verden litt før ham, skrev Einstein, og det betydde ingenting. En måned senere døde Einstein selv."@nb ;
  v:region v:time ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:exampleOf n:block-universe ;
