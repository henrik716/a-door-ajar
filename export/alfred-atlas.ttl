# note: n:few-views-weigh-the-atoms v:qualifies n:two-beginnings — striden står om deler, ikke om bevissthet
n:filter-theory a v:Position ;
  rdfs:label "Vei 1: Innsiden tar båndene med seg"@nb ;
  v:shortLabel "Vei 1: Filterteorien"@nb ;
  rdfs:comment "Hjernen lager ikke bevisstheten, men slipper den gjennom, slik et prisme slipper gjennom lys. Bergson mente at minner ikke er lagret i hjernen. Den veien som passer håpet best, og den som har sterkest bevis imot seg."@nb ;
  v:region v:borderland ;
  v:strength v:contested ;
  v:hopeLevel 6 ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
