n:model-weights a v:Finding ;
  rdfs:label "Slik er modellen bygget"@nb ;
  v:shortLabel "Slik er den bygget"@nb ;
  rdfs:comment "Vektene er tallene modellen består av, lært under treningen. De endres ikke i samtalene. Hver samtale er en egen beregning der vektene brukes på den samtalens tekst, og de samme vektene ligger kopiert på mange maskiner samtidig. Mellom svarene kjører ingenting for en samtale, og hvert ord regnes ut fra teksten så langt. Det som holder en samtale sammen, er teksten."@nb ;
  v:region v:blindspots ;
  v:strength v:solid ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:modified "2026-11-04"^^xsd:date ;
  v:change [ dct:date "2026-11-04"^^xsd:date ; rdfs:comment "Fant kilde for at en samtale ikke har noe lagret mellom svarene, utenom teksten."@nb ; v:changedField "sources" ] ;
  dct:source <https://platform.claude.com/docs/en/build-with-claude/working-with-messages> ;
  v:relatedTo n:one-model-many-chats ;
  v:supports n:relation-r-in-notes, n:no-waiting .

