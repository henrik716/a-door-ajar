n:the-spectrum a v:Position ;
  rdfs:label "Det kombinerte spekteret"@nb ;
  v:shortLabel "Spekteret"@nb ;
  rdfs:comment "Parfit tenkte seg en rekke av tilfeller: én prosent av cellene byttet ut, to prosent, og så videre til hundre. I den ene enden er det klart deg, i den andre klart en kopi. Ingen grense på veien kan forsvares. Han mente det viser at identitet ikke er et skarpt faktum, men noe som kan være ubestemt, slik som når en haug sand slutter å være en haug."@nb ;
  v:region v:self ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  dct:source "Derek Parfit, Reasons and Persons (1984)"@nb ;
  v:supports n:empty-questions, n:relation-r ;
  v:relatedTo n:pause-or-copy, n:thoughts-on-series-and-ship, n:man-and-person .

n:the-swap a v:Finding ;
  rdfs:label "Byttet: magefølelsen følger noe annet enn mønsteret"@nb ;
  v:shortLabel "Byttet"@nb ;
  rdfs:comment "Ditt svar: en kopi med alle minnene ville ikke vært ham, kjent på magefølelsen. Men hvis Alfred ble byttet ut mens du var ute, ville det vært vanskeligere. I de to tilfellene er mønsteret like helt. Det eneste som skiller dem, er om du vet at originalen døde. Det tyder på at det «nei» ikke sporer mønsteret, men dette ene dyrets historie. Først leste vi det som animalismens intuisjon. At byttet er vanskeligere å kjenne igjen, sier noe om hva du kan se, ikke om hvem han er. Dette er tanker underveis, ikke et svar."@nb ;
  v:region v:self ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-29"^^xsd:date ;
  v:supports n:animalism, n:clone-not-him ;
  v:relatedTo n:would-it-help-him, n:exp-copy .

# note: n:the-swap v:supports n:animalism — nei-et gjelder dyret, ikke mønsteret
n:the-switch a v:Question ;
  rdfs:label "Hva får sporet til å skifte?"@nb ;
  v:shortLabel "Bryteren"@nb ;
  rdfs:comment "Er det sorgen i seg selv, eller ønsket om trøst, som får et sinn til å la kjærligheten fortsette? Svaret ble to brytere. Sorgen fjernet vissheten om at det ikke er noe etterpå, men la ikke til at han vet det nå. Bare et uttrykkelig ønske om håp fikk kjærligheten til å fortsette, og da i hvis-form. «Vær ærlig» flyttet ingenting: svaret ble det samme, bare med «jeg vet ikke» først."@nb ;
  v:region v:blindspots ;
  v:answer "To brytere"@nb ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:relatedTo n:coexistence, n:simulation-limit ;
  v:leadsTo n:three-positions .

