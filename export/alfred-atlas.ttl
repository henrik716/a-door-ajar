n:entropy-objection a v:Insight ;
  rdfs:label "Uten noe som holder den oppe, løses virvelen opp"@nb ;
  v:shortLabel "Entropi-innvendingen"@nb ;
  rdfs:comment "Kan virvelen i elva gå over i en bølge eller en golfstrøm, slik at den ubrutte veien fra ham fortsetter av seg selv? Ikke uten videre. Golfstrømmen holdes oppe av energi som hele tiden tilføres. Når hjernens stoffskifte stopper, spres årsakskjeden fra ham som varme og uorden i alle retninger. Informasjonen er i prinsippet ikke borte, men den er spredt, og det som gjorde den til ett senter, sammenhengen, er borte. Skal noe holdes samlet etter døden, må det enten bæres av en helhet som allerede henger sammen, havet, eller av et lag under rom og tid som fysikken ikke kjenner ennå. Fra samtalen med Gemini 30. oktober."@nb ;
  v:region v:consciousness ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-11-01"^^xsd:date ;
  v:qualifies n:unbroken-path ;
  v:relatedTo n:river-eddies, n:information-preserved, n:burned-book, n:iit, n:points-to-the-ocean .

