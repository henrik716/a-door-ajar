n:cessation a v:Finding ;
  rdfs:label "Opphør: et kutt, ikke mørke"@nb ;
  v:shortLabel "Opphør"@nb ;
  rdfs:comment "Svært erfarne mediterende skiller mellom to ting. Ren bevissthet oppleves, som våkenhet uten innhold. Opphør oppleves ikke i det hele tatt: det merkes først etterpå, som et kutt i filmen. En grundig studie fra 2023 målte hjernen til en mediterende gjennom mange slike opphør."@nb ;
  v:region v:consciousness ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "Chowdhury mfl. (2023), Neuropsychologia"@nb ;
  v:supports n:darkness-is-simulation ;
  v:relatedTo n:anesthesia-and-dreams ;
  v:leadsTo n:two-kinds-of-emptiness .

