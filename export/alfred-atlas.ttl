  rdfs:label "Locke: for et dyr er det det samme livet som teller"@nb ;
  v:shortLabel "Locke om dyr"@nb ;
  rdfs:comment "Locke er kilden til minnekriteriet: personen strekker seg så langt minnene når. Men han ga det bare til personer, og en person er etter ham et tenkende vesen med fornuft og refleksjon, som kan tenke på seg selv som seg selv til ulike tider og steder. For dyr gir han et annet svar i det samme kapitlet: et dyr er det samme så lenge det samme livet fortsetter i én organisert kropp, mens stoffet i den skiftes ut. Om en hund er en person i hans forstand, drøfter han ikke, men kravet om refleksjon gjør det tvilsomt. Da er Locke i sin egen bok animalist om Alfred. Minnekriteriet, som kartet har knyttet til ham, var ikke ment for en hund."@nb ;
  v:region v:self ;
  v:strength v:position ;
  v:conversation v:map ;
  dct:created "2026-11-03"^^xsd:date ;
  dct:source <https://humanum.arts.cuhk.edu.hk/Philosophy/Locke/echu/lok0037.htm> ;
  v:answers n:self-questions-for-a-dog ;
  v:supports n:animalism ;
  v:qualifies n:t-content, n:man-and-person .

# note: n:locke-on-animals v:supports n:animalism — for et dyr som ikke er en person
# note: n:locke-on-animals v:qualifies n:t-content — Locke ga minnekriteriet bare til personer
n:love-goes-last a v:Insight ;
  rdfs:label "Kjærligheten er det siste som går"@nb ;
  v:shortLabel "Kjærligheten går sist"@nb ;
  rdfs:comment "I levende hjerner varer følelser og gjenkjennelse lenger enn minnene om hendelser. Det er akkurat det barna i Berings forsøk lot musa beholde. Kanskje er ikke intuisjonen tilfeldig, men peker på det dypeste laget i et levende sinn. Det gjelder bare så lenge hjernen lever, og sier ingenting om etterpå."@nb ;
  v:region v:borderland ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:qualifies n:simulation-limit ;
