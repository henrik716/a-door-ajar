n:feinstein a v:Finding ;
  rdfs:label "Følelsen varer lenger enn minnet"@nb ;
  v:shortLabel "Følelsen varer lenger"@nb ;
  rdfs:comment "Pasienter med alvorlig hukommelsestap så triste og glade filmklipp. Etter noen minutter husket de ikke klippene, men følelsen satt igjen, noen ganger lenger enn hos friske."@nb ;
  v:region v:borderland ;
