n:kant-forms-of-mind a v:Position ;
  rdfs:label "Rom og tid er sinnets former"@nb ;
  rdfs:comment "Rom og tid er ikke egenskaper ved verden i seg selv, men formene sinnet legger over alt det opplever, omtrent som et hundesinn har sine former. Påfallende: begge sorgspørsmålene, «hvor» og «nå», stilles i akkurat disse to formene."@nb ;
  v:region v:time ;
  v:strength v:position ;
  v:conversation v:deepdive ;
