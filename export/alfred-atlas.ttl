n:deprivation a v:Position ;
  rdfs:label "Døden er et tap for den som dør"@nb ;
  v:shortLabel "Tapsteorien"@nb ;
  rdfs:comment "Nagels svar til Epikur: døden er ikke vond fordi den oppleves, men fordi den tar fra en det gode en ellers ville hatt. Da kan døden være et tap for Alfred også, selv om han aldri merker det. Det er et av de vanligste synene blant filosofer i dag."@nb ;
  v:region v:grief ;
  v:strength v:position ;
  v:conversation v:deepdive ;
