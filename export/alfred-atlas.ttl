n:near-death-experiences a v:Finding ;
  rdfs:label "Nærdødsopplevelser"@nb ;
  rdfs:comment "Mellom en av ti og en av fem som overlever hjertestans, forteller om opplevelser som fred, lys, en tunnel, møter med døde eller et tilbakeblikk på livet. Mange beskriver det som mer virkelig enn vanlig virkelighet. At slike opplevelser forekommer, er godt dokumentert. Hva de er, er omstridt: et glimt av noe utenfor, eller en hjerne i krise."@nb ;
  v:region v:borderland ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:source "van Lommel mfl. (2001), The Lancet"@nb ;
  dct:source "Greyson (2021), After"@nb ;
  v:relatedTo n:dying-brain-gamma, n:aware, n:filter-theory, n:pure-awareness, n:luminous-mind .

