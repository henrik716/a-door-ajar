  v:usesWord n:word-memory .

n:fine-or-realistic a v:Finding ;
  rdfs:label "Det fine og det realistiske, skilt før testen"@nb ;
  v:shortLabel "Fint og realistisk"@nb ;
  rdfs:comment "Dine tanker: Før du leste svarene, rangerte du synene to ganger. Etter hvor fine de er, sto havet og en egen strøm øverst. Havet var det varmeste, og strømmen var fin fordi individet går videre. Etter hvor realistiske de kjennes, sto slutten først, men med mer tvil enn før. Så kom støvet, så havet nesten likt med det, og strømmen hakket under. Du skilte det fine fra det realistiske selv. Én forskjell fra modellene: du satte en egen strøm nesten like høyt som havet, der alle modellene satte den sist. Tanker underveis, ikke et svar."@nb ;
  v:region v:blindspots ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:map ;
  dct:created "2026-11-02"^^xsd:date ;
  v:qualifies n:why-the-ocean-pulls ;
  v:relatedTo n:ocean-test, n:one-ocean-or-dust .

# note: n:fine-or-realistic v:qualifies n:why-the-ocean-pulls — det fine og det realistiske skilt før testen
n:firewood-and-ash a v:Position ;
  rdfs:label "Ved og aske"@nb ;
  rdfs:comment "Ved blir til aske og blir ikke ved igjen. Men Dōgen sier at man ikke skal tenke at asken er etterpå og veden før. Veden står på sin egen plass, hel. Liv og død er som vinter og vår: vi kaller ikke vinteren begynnelsen på våren. Alfreds liv er ikke en mindre virkelig fortid. Det står på sin egen plass, fullt ut. Med fysikkens øyne er veden og asken mye av det samme stoffet, bare med mer entropi, og det er den veien hele universet går. Informasjonen om veden er i prinsippet ikke borte. Dōgen og fysikken sier altså noe likt fra hver sin kant: veden er ikke mindre virkelig fordi den er brent."@nb ;
  v:region v:east ;
  v:strength v:position ;
  v:hopeLevel 1 ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:challengesWord n:word-now ;
  v:supports n:cannot-be-undone ;
  v:relatedTo n:block-universe, n:having-been, n:information-preserved .

n:fish-in-the-hao a v:Image ;
  rdfs:label "Fiskene i Hao-elva"@nb ;
  rdfs:comment "Zhuangzi sier at fiskene under brua er glade. Huizi: du er ikke en fisk, hvordan kan du vite det? Zhuangzi: du er ikke meg, hvordan vet du at jeg ikke vet det? Til slutt: jeg vet det herfra, fra brua over Hao. Kunnskapen om en annens innside kommer fra stedet man står ved siden av den. Du visste at Alfred var glad, herfra."@nb ;
  v:region v:east ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:answers n:other-minds ;
  v:relatedTo n:not-knowing-is-not-new .

n:fish-trap a v:Image ;
  rdfs:label "Fiskefella"@nb ;
  rdfs:comment "Fiskefella finnes for fiskens skyld. Når du har fisken, kan du glemme fella. Ord finnes for meningens skyld. Når du har meningen, kan du glemme ordene. Zhuangzi lurte på hvor han kunne finne en som hadde glemt ordene, så han kunne snakke med ham."@nb ;
  v:region v:east ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:exampleOf n:questions-can-dissolve ;
  v:relatedTo n:map-not-territory .

n:five-stages a v:Position ;
  rdfs:label "Sorgens fem stadier"@nb ;
  v:shortLabel "Fem stadier"@nb ;
  rdfs:comment "Kübler-Ross beskrev fem faser hos døende: benekting, sinne, forhandling, depresjon og aksept. Modellen ble senere brukt om sorg og er kanskje den mest kjente ideen om sorg som finnes. Forskningen finner ingen fast rekkefølge, og mange går aldri gjennom alle fasene."@nb ;
  v:region v:grief ;
  v:strength v:contested ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:relatedTo n:grief-work .

n:flame-through-the-night a v:Image ;
  rdfs:label "Flammen gjennom natta"@nb ;
  rdfs:comment "Kongen spør om den som gjenfødes, er den samme eller en annen. Nagasena svarer med en lampe som brenner hele natta: flammen ved daggry er verken den samme som om kvelden eller en annen. Et tomt spørsmål, besvart nesten slik Parfit ville gjort det."@nb ;
  v:region v:east ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:exampleOf n:empty-questions, n:rebirth-without-self ;
  v:challengesWord n:word-same .

n:flicker-fusion a v:Finding ;
  rdfs:label "Hunder ser flimmer raskere"@nb ;
  rdfs:comment "Hunder oppfatter flimmer ved høyere frekvens enn mennesker. Det er målt i atferdsforsøk på beagler, og en stor sammenstilling oppgir rundt 80 hertz for hund og 60 for menneske, men metodene er ulike, så forskjellen er usikker. Det som måles, er hvor fort synet følger med, ikke hvordan tid oppleves. En gjennomgang fant lite som tyder på at flimmerterskelen følger opplevd tid. At synsnået hans var mer finmasket enn vårt, er derfor en slutning, ikke et funn."@nb ;
  v:region v:dog ;
  v:strength v:solid ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:modified "2026-11-04"^^xsd:date ;
  v:change [ dct:date "2026-11-04"^^xsd:date ; rdfs:comment "Fant kilder. Skilte det som er målt, flimmeret, fra slutningen om et mer finmasket nå. Lenken til «Alfred levde i et annet nå» endret fra støtter til nyanserer."@nb ; v:changedField "text", "sources", "links" ] ;
