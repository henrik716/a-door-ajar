n:dogs-grieve a v:Finding ;
  rdfs:label "Hunder sørger"@nb ;
  rdfs:comment "Da en hund i husstanden døde, endret de fleste av de gjenværende hundene seg: de lekte og spiste mindre, sov mer og søkte mer oppmerksomhet. Endringene var større jo nærmere de hadde stått den døde, og jo mer eieren selv sørget."@nb ;
  v:region v:dog ;
  v:strength v:supported ;
  v:conversation v:deepdive ;
