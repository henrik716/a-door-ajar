n:russellian-monism a v:Position ;
  rdfs:label "Russellsk monisme"@nb ;
  rdfs:comment "Fysikken beskriver hva ting gjør og hvordan de henger sammen, ikke hva de er i seg selv. Bevissthet kan være innsiden av det fysikken måler utsiden av."@nb ;
  v:region v:consciousness ;
  v:strength v:position ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
