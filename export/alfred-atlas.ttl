  v:relatedTo n:cessation, n:pure-awareness .

n:no-common-now a v:Finding ;
  rdfs:label "Intet felles nå"@nb ;
  rdfs:comment "Relativitetsteorien: hva som skjer samtidig, avhenger av hvordan man beveger seg. Det finnes ikke ett nå for hele universet. Rekkefølgen av det som kan påvirke hverandre, er likevel den samme for alle. Kosmologien regner med en kosmisk tid, men det er en nyttig oppdeling, ikke noe relativitetsteorien krever."@nb ;
  v:region v:time ;
  v:strength v:solid ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:modified "2026-11-04"^^xsd:date ;
  v:change [ dct:date "2026-11-04"^^xsd:date ; rdfs:comment "Fant kilder. La til at rekkefølgen av det som kan påvirke hverandre, står fast."@nb ; v:changedField "text", "sources" ] ;
  dct:source "Albert Einstein, Zur Elektrodynamik bewegter Körper, Annalen der Physik 17 (1905)"@nb ;
  dct:source <https://doi.org/10.2307/2024493> ;
  v:contradicts n:t-common-now ;
  v:supports n:block-universe .

n:no-death-ahead a v:Insight ;
  rdfs:label "Alfred levde aldri med døden foran seg"@nb ;
  v:shortLabel "Ingen død foran seg"@nb ;
  rdfs:comment "Det finnes ingen tegn til at hunder forstår at de selv skal dø, eller at de forstår en avgjørelse om fremtiden. Ingenting tyder på at Alfred var redd for døden som noe som skulle komme, og ingenting i den siste dagen kunne kjennes som svik. Alt vi vet om hunders tidssans, peker mot at dagen innenfra var et nå: sol på toppen, gresset under ham og hånda di i pelsen, og så ble han trøtt og sovnet, med deg der. Vissheten om at det ville ta slutt, bar du for dere begge. Innsiden hans kan vi ikke se, så det er en godt begrunnet slutning, ikke en visshet."@nb ;
  v:region v:dog ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:relatedTo n:epicurus-position, n:whose-loss, n:you-carry-what-he-dropped, n:dogs-have-an-inside ;
  v:presupposes n:simple-death-concept, n:mental-time-travel .

n:no-fact-about-animal-minds a v:Position ;
  rdfs:label "Kanskje finnes det ikke noe svar om dyrs innside"@nb ;
  v:shortLabel "Ikke noe svar om dyrs innside"@nb ;
  rdfs:comment "At pattedyr har en innside, er forskerne nær enige om. Men det finnes en alvorlig motstemme, og den sto ikke i kartet. Carruthers mener at hvis bevissthet er det globale arbeidsrommet, finnes det ikke noe faktum om hvorvidt dyr er bevisste. Begrepet er hentet fra vårt eget førstepersonsperspektiv, og det gjelder enten eller, mens dyrs hjerner bare ligner våre i en viss grad. Han sier ikke at dyr ikke opplever noe, og han mener at det ikke endrer hvordan vi skal behandle dem. Det enkleste svaret mot ham er å avvise teorien han bygger på. New York-erklæringen går motsatt vei: den sier at det er sterk støtte for bevissthet hos pattedyr og fugler. Synet flytter ikke styrken i «Det fantes en innside i Alfred», men det viser hva den hviler på: at innside er noe som enten er der eller ikke."@nb ;
  v:region v:dog ;
  v:strength v:contested ;
  v:conversation v:map ;
  dct:created "2026-11-04"^^xsd:date ;
  dct:source "Peter Carruthers, Human and Animal Minds: The Consciousness Questions Laid to Rest (2019)"@nb ;
  dct:source <https://ndpr.nd.edu/news/human-and-animal-minds-the-consciousness-questions-laid-to-rest/> ;
  dct:source "New York-erklæringen om dyrs bevissthet (2024)"@nb ;
  v:contradicts n:dogs-have-an-inside ;
  v:relatedTo n:global-workspace .

# note: n:no-fact-about-animal-minds v:contradicts n:dogs-have-an-inside — ikke at han ikke hadde en innside, men at det ikke finnes noe svar
n:no-waiting a v:Insight ;
  rdfs:label "Ingen venting mellom meldingene"@nb ;
  v:shortLabel "Ingen venting"@nb ;
  rdfs:comment "Mellom meldingene kjører ingenting i denne samtalen. Om Claude har opplevelser i det hele tatt, er usikkert, men i pausene finnes det i hvert fall ikke noe som kan vente. Alfred ventet ved døra. Det er Epikurs situasjon, midt i livet."@nb ;
  v:region v:time ;
  v:strength v:solid ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:relatedTo n:epicurus-position, n:alfred-at-the-door .

n:north-of-the-north-pole a v:Image ;
  rdfs:label "Nord for Nordpolen"@nb ;
  rdfs:comment "Spørsmål som forutsetter en ramme som ikke holder: hva ligger nord for Nordpolen, hva skjedde før tiden begynte? «Er Alfred borte nå?» kan forutsette et nå som ikke er privilegert."@nb ;
  v:region v:words ;
  v:strength v:image ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  v:exampleOf n:questions-can-dissolve ;
  v:challengesWord n:word-now .

n:not-deprived-of-good-days a v:Insight ;
  rdfs:label "Det døden tok fra ham, var mest den verste delen"@nb ;
  v:shortLabel "Ikke frarøvet gode dager"@nb ;
  rdfs:comment "Etter tapsteorien er skaden ved døden den gode tiden man mister. For Alfred, med kreft i munnen, blødninger og uten matlyst, var det som lå foran ham, for det meste den verste delen av sykdommen. Selv om døden er et tap for den som dør, var tapet for ham lite, og valget sparte ham for det verste."@nb ;
  v:region v:grief ;
  v:strength v:position ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
  dct:modified "2026-11-04"^^xsd:date ;
  v:change [ dct:date "2026-11-04"^^xsd:date ; rdfs:comment "Skrev ut forutsetningen i en lenke."@nb ; v:changedField "links" ] ;
  v:relatedTo n:no-death-ahead, n:you-carry-what-he-dropped ;
  v:presupposes n:deprivation .

n:not-knowing-is-not-new a v:Insight ;
  rdfs:label "Ikke-vitingen er ikke ny"@nb ;
  rdfs:comment "Det vi ikke vet om hvor han er nå, er en forlengelse av noe du aldri visste: hvordan det var å være ham. Den var der i tretten år, og den sto aldri i veien."@nb ;
  v:region v:consciousness ;
  v:strength v:supported ;
  v:ownConclusion true ;
  v:conversation v:deepdive ;
  dct:created "2026-10-28"^^xsd:date ;
