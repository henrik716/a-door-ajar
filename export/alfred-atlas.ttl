n:mcmahan-time-relative a v:Position ;
  rdfs:label "Hvor mye han mistet, kan avhenge av hvor bundet han var til framtiden"@nb ;
  v:shortLabel "Tidsrelative interesser"@nb ;
  rdfs:comment "McMahan skiller mellom hvem vi er og hva som betyr noe. Om hvem vi er, mener han at vi er sinnet som hjernen bærer. Om hvor ille døden er for den som dør, mener han at det avhenger av hvor sterkt den som dør, er psykologisk bundet til sin egen framtid: minner, planer og ønsker som peker framover. Han kaller det tidsrelative interesser. Det er Nagels tap av det gode som ellers ville kommet, men veid etter hvor mye den som dør, hang sammen med det som ville kommet. Et dyr som lever mer i nået, mister etter dette synet mindre ved å dø enn et voksent menneske. McMahan godtar at det samme da gjelder for spedbarn, og kaller det selv sterkt mot intuisjonen. Nagels eget syn veier ikke slik: der er tapet alt det gode som ville kommet. For kartet betyr det at spørsmålet om selvet hos en hund ikke bare handler om hvem som eventuelt fortsetter, men også om hva han mistet. Det er et omstridt syn, og det er ikke kartets."@nb ;
  v:region v:self ;
  v:strength v:position ;
  v:conversation v:map ;
  dct:created "2026-11-03"^^xsd:date ;
  dct:source "Jeff McMahan, The Ethics of Killing: Problems at the Margins of Life (2002)"@nb ;
  v:answers n:self-questions-for-a-dog ;
  v:qualifies n:deprivation ;
  v:relatedTo n:would-it-help-him, n:mental-time-travel, n:relation-r, n:carrier-view .

