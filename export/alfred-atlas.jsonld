    {
      "@id": "n:five-stages",
      "@type": "v:Position",
      "label": {
        "nb": "Sorgens fem stadier"
      },
      "text": {
        "nb": "Kübler-Ross beskrev fem faser hos døende: benekting, sinne, forhandling, depresjon og aksept. Modellen ble senere brukt om sorg og er kanskje den mest kjente ideen om sorg som finnes. Forskningen finner ingen fast rekkefølge, og mange går aldri gjennom alle fasene."
      },
