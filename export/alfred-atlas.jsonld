    {
      "@id": "n:laughter-in-grief",
      "@type": "v:Finding",
      "label": {
        "nb": "Latter i sorgen"
      },
      "text": {
        "nb": "Ekte latter når folk fortalte om den de hadde mistet, håndet sammen med bedre tilpasning senere. Når du ler av noe Alfred gjorde, er det ikke sorgen som svikter. Det er båndet som virker."
      },
