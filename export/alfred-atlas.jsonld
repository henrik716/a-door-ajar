    {
      "@id": "n:meaning-after-loss",
      "@type": "v:Finding",
      "label": {
        "nb": "Å finne mening etter tapet"
      },
      "text": {
        "nb": "Å klare å finne en mening i et tap er blant de tydeligste tegnene på hvordan sorgen vil gå videre. Det betyr ikke en trøstende forklaring på hvorfor det skjedde, men at tapet får plass i en historie man kan leve med."
      },
      "region": "v:grief",
      "strength": "v:supported",
