      "supports": [
        "n:thin-wall"
      ]
    },
    {
      "@id": "n:self-as-agent",
      "@type": "v:Position",
      "label": {
        "nb": "Vi må være én for å kunne handle"
      },
      "text": {
        "nb": "Korsgaards svar til Parfit: selv om det ikke finnes noen dyp kjerne, må et vesen som handler, se seg selv som én gjennom tiden. Den som tar et valg i dag, må bære det i morgen. Enheten er ikke et faktum vi finner, men noe vi må gjøre oss til for å kunne leve. For Alfred, som ikke la planer for fremtiden, gjelder det kanskje mindre enn for oss."
      },
      "region": "v:self",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Selvet som handlende"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
        "Christine Korsgaard, Personal Identity and the Unity of Agency: A Kantian Response to Parfit (1989)"
      ],
      "qualifies": [
        "n:reductionism"
      ],
      "relatedTo": [
        "n:mental-time-travel"
      ],
      "notes": [
        "v:qualifies n:reductionism: enheten er praktisk, ikke metafysisk"
      ],
      "qualifiesDerived": [
        "n:open-closed-same-facts",
        "n:relation-r-in-notes",
        "n:you-loved-the-connections"
      ]
    },
    {
      "@id": "n:self-other-overlap",
      "@type": "v:Finding",
      "label": {
        "nb": "Selv-andre-overlapp"
      },
      "text": {
        "nb": "I nære relasjoner tar vi den andre inn i vårt eget selvbilde. Folk bruker lengre tid på å skille sine egne egenskaper fra partnerens, fordi grensen er blitt utydelig."
      },
      "region": "v:limits",
      "strength": "v:solid",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "supports": [
        "n:thin-wall",
        "n:grief-and-self-concept"
      ]
    },
    {
      "@id": "n:sensing-presence",
      "@type": "v:Finding",
      "label": {
        "nb": "Å kjenne nærværet"
      },
      "text": {
        "nb": "Nesten halvparten av enkene og enkemennene i en klassisk studie hadde kjent nærværet av den døde, eller sett eller hørt dem. Det samme beskrives etter tap av et dyr: å høre labbene, kjenne vekten i senga. De fleste forskere ser det som hjernens kart som fortsatt forventer, og det er ikke et tegn på at noe er galt. For mange er det en trøst."
      },
      "region": "v:grief",
      "strength": "v:supported",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
        "Rees (1971), British Medical Journal",
        "Packman mfl. (2012), Omega"
      ],
      "relatedTo": [
        "n:grief-is-learning",
        "n:inner-outer-bonds",
        "n:lasting-bonds"
      ]
    },
