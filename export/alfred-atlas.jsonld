    {
      "@id": "n:inaccessible-not-deleted",
      "@type": "v:Finding",
      "label": {
        "nb": "Utilgjengelig er ikke slettet"
      },
      "text": {
        "nb": "Mus som hadde mistet et minne og ikke kunne hente det fram selv, fikk det tilbake når forskerne belyste cellene som bar det. Minnet lå der fortsatt, i mønsteret av forbindelser. Det passer med at mennesker med demens noen ganger blir klare like før de dør. Men det svekker bare slutningen «husker ikke, altså borte», ikke slutningen «hjernen er borte, altså borte». Det som overlevde i musene, var fortsatt et mønster inne i hjernen, ikke et lager utenfor den."
      },
      "region": "v:borderland",
      "strength": "v:supported",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
        "Ryan mfl. (2015), Science"
      ],
      "qualifies": [
        "n:memory-in-the-brain"
      ],
      "supports": [
        "n:paradoxical-lucidity"
      ]
    },
