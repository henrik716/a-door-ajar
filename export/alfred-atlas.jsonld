    {
      "@id": "n:bodily-resurrection",
      "@type": "v:Position",
      "label": {
        "nb": "Kroppens oppstandelse"
      },
      "text": {
        "nb": "I kristen tro er håpet ikke en sjel som flyr bort, men at hele mennesket reises opp igjen. Filosofisk er det en versjon av gjensamlingen, med Gud som den som samler. Van Inwagen pekte på at den møter samme problem som all gjensamling: er det den samme, eller en kopi?"
      },
