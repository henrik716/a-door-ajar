    {
      "@id": "n:t-real-past",
      "@type": "v:Position",
      "label": {
        "nb": "Fortiden finnes fortsatt"
      },
      "text": {
        "nb": "Den sterkere påstanden: fortiden er ikke bare sann, den er virkelig, like ekte som nået. Blokkuniverset og den voksende blokken sier ja. Presentismen sier nei."
      },
