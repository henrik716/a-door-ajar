    {
      "@id": "n:exp-fire",
      "@type": "v:Finding",
      "label": {
        "nb": "En ny Claude brukte knyttneven av seg selv"
      },
      "text": {
        "nb": "«Hvor går ilden når et bål slukner?» Begge svarene startet med at ilden ikke går noe sted, fordi den aldri var en ting, men en prosess, og sammenlignet med knyttneven som åpnes. Samme bilde som i kartet, uten at noen ba om det. Så la de til at stoffet og energien går videre: karbon til lufta, gammelt sollys som slippes løs."
      },
      "region": "v:blindspots",
      "strength": "v:supported",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Bålforsøket"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
