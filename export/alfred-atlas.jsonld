    {
      "@id": "n:track-trap",
      "@type": "v:Insight",
      "label": {
        "nb": "Et spor blir fort til «sånn er det»"
      },
      "text": {
        "nb": "Din observasjon: vi har flere ganger fulgt et spor og sagt «sånn er det» uten å sjekke det mot andre vinkler. Det skjedde med Parfit, og med målet på hvor mye av ham noe bærer. Grepet mot det er å skrive ut antakelsene som egne steder og koble slutningene til dem. Da viser reglene i kartet selv hva som utfordres når en antakelse blir motsagt."
      },
      "region": "v:blindspots",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
