      ]
    },
    {
      "@id": "n:tetralemma",
      "@type": "v:Position",
      "label": {
        "nb": "Fire hjørner"
      },
      "text": {
        "nb": "Nagarjuna gjorde de fire svarene til en metode: finnes, finnes ikke, begge deler, ingen av delene. Når alle fire faller, er det et tegn på at spørsmålet bygger på en antakelse som ikke holder. «Finnes ikke» avvises like hardt som «finnes»."
      },
      "region": "v:east",
      "strength": "v:position",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
