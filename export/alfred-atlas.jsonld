    {
      "@id": "n:the-bond-moves",
      "@type": "v:Insight",
      "label": {
        "nb": "Båndet får en ny adresse"
      },
      "text": {
        "nb": "Å slippe er kanskje feil ord. Båndet forsvinner ikke, det flytter: fra døra og terrassen til deg, til turene, til måten du tar vare på et dyr, til historiene du forteller. Hjernen trenger tid på å lære flyttingen, og det er det som gjør vondt nå."
      },
      "region": "v:grief",
      "strength": "v:position",
