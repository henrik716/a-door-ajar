    {
      "@id": "n:now-made-by-brain",
      "@type": "v:Finding",
      "label": {
        "nb": "Nået er laget av hjernen"
      },
      "text": {
        "nb": "Det opplevde nået har bredde, noen sekunder, som William James påpekte. Eksperimenter viser at hjernen setter sammen øyeblikket i etterkant. Det du opplever som nå, er en redigert versjon av noe som allerede har vært."
      },
      "region": "v:time",
      "strength": "v:solid",
      "conversation": "v:deepdive",
