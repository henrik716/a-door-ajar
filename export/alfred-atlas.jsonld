    {
      "@id": "n:drum-on-the-pot",
      "@type": "v:Image",
      "label": {
        "nb": "Trommen på gryta"
      },
      "text": {
        "nb": "Da kona døde, fant vennen Huizi Zhuangzi sittende og tromme på en gryte. Zhuangzi sa at han først sørget som alle andre. Så tenkte han på at hun en gang ikke fantes, så ble liv, og nå gikk videre, slik årstidene går. Sorgen kom først. Trommingen kom etterpå."
      },
      "region": "v:east",
