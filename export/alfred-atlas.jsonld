    {
      "@id": "n:bewitchment",
      "@type": "v:Position",
      "label": {
        "nb": "Språket forhekser forstanden"
      },
      "text": {
        "nb": "Den sene Wittgenstein mente at filosofiske problemer oppstår når språket tar fri: når ord brukes utenfor sammenhengen de hører hjemme i. Filosofi blir da en kamp mot forheksingen av forstanden ved hjelp av språket. Det er den viktigste kilden til feil ord-tråden."
      },
      "region": "v:words",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Forheksingen"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
        "Filosofiske undersøkelser (1953), § 38 og § 109"
      ],
      "supports": [
