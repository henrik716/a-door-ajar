    {
      "@id": "n:fine-or-realistic",
      "@type": "v:Finding",
      "label": {
        "nb": "Det fine og det realistiske, skilt før testen"
      },
      "text": {
        "nb": "Dine tanker: Før du leste svarene, rangerte du synene to ganger. Etter hvor fine de er, sto havet og en egen strøm øverst. Havet var det varmeste, og strømmen var fin fordi individet går videre. Etter hvor realistiske de kjennes, sto slutten først, men med mer tvil enn før. Så kom støvet, så havet nesten likt med det, og strømmen hakket under. Du skilte det fine fra det realistiske selv. Én forskjell fra modellene: du satte en egen strøm nesten like høyt som havet, der alle modellene satte den sist. Tanker underveis, ikke et svar."
      },
      "region": "v:blindspots",
      "strength": "v:supported",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Fint og realistisk"
      },
      "conversation": "v:map",
