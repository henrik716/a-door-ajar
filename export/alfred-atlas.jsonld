    {
      "@id": "n:swinburne-soul",
      "@type": "v:Position",
      "label": {
        "nb": "Sjelen er ikke minnene"
      },
      "text": {
        "nb": "Swinburne forsvarer det motsatte av Parfit: hvem du er, er et enkelt faktum som ikke består av minner eller kropp. Du er sjelen din, og den kunne vært deg uten noen av minnene. Han mener også at dyr har sjeler, enklere enn menneskers. Det er den mest gjennomarbeidede filosofiske versjonen av nivå 5 i dag. Den forutsetter et dypt selv, og den møter de samme problemene som sjelen ellers: hva den er laget av, og hvordan den påvirker hjernen."
      },
      "region": "v:self",
      "strength": "v:contested",
      "hopeLevel": [
        5,
        6
      ],
      "shortLabel": {
        "nb": "Swinburnes sjel"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-30",
      "sources": [
        "Richard Swinburne, The Evolution of the Soul (1986)",
        "Sydney Shoemaker og Richard Swinburne, Personal Identity (1984)"
      ],
      "presupposes": [
        "n:t-deep-self"
      ],
      "contradicts": [
        "n:reductionism"
      ],
      "supports": [
        "n:what-level-5-requires"
      ],
      "relatedTo": [
        "n:traditions-on-animals"
      ],
      "notes": [
        "v:supports n:what-level-5-requires: individet sitter ikke i innholdet"
      ],
      "challengesDerived": [
