    {
      "@id": "n:lewis-animals",
      "@type": "v:Position",
      "label": {
        "nb": "Dyr som lever videre i og med menneskene sine"
      },
      "text": {
        "nb": "Lewis gjettet på at tamme dyr kan få del i det evige gjennom forholdet til menneskene sine. Hunden blir noen i kraft av husstanden den hører til, og hvis noe av den består, er det i og med dem. Det er en kristen versjon av tanken om at det er båndet, ikke dyret alene, som eventuelt fortsetter. Lewis kalte det selv en gjetning."
      },
      "region": "v:borderland",
