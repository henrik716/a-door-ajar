      ]
    },
    {
      "@id": "n:grief-for-an-animal",
      "@type": "v:Finding",
      "label": {
        "nb": "Sorg over et dyr er ekte sorg"
      },
      "text": {
        "nb": "Studier finner at sorgen etter et dyr kan være like sterk som etter et menneske. Den blir likevel ofte mindre anerkjent av omgivelsene, det som kalles uanerkjent sorg. Dybden du kjenner, er ikke en overreaksjon."
      },
      "region": "v:grief",
      "strength": "v:supported",
      "shortLabel": {
