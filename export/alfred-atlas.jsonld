    {
      "@id": "n:love-goes-last",
      "@type": "v:Insight",
      "label": {
        "nb": "Kjærligheten er det siste som går"
      },
      "text": {
        "nb": "I levende hjerner varer følelser og gjenkjennelse lenger enn minnene om hendelser. Det er akkurat det barna i Berings forsøk lot musa beholde. Kanskje er ikke intuisjonen tilfeldig, men peker på det dypeste laget i et levende sinn. Det gjelder bare så lenge hjernen lever, og sier ingenting om etterpå."
      },
      "region": "v:borderland",
      "strength": "v:supported",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Kjærligheten går sist"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "qualifies": [
