      ]
    },
    {
      "@id": "n:binary-graph",
      "@type": "v:Insight",
      "label": {
        "nb": "Grafen regner binært, innsiktene gjør det ikke"
      },
      "text": {
        "nb": "Reglene i kartet regner som en klassisk sannhetsmaskin: motsier man en forutsetning, utfordres det som bygger på den. Men flere av de viktigste stedene handler om at ja og nei bryter sammen: Nagarjunas fire hjørner, Buddhas ubesvarte spørsmål, flammen som verken er den samme eller en annen, Parfits spekter og rekken fra pause til kopi. Der tekstene sier grader og nivåer, tvinger grafen fram ja eller nei. Det er den samme feilen som at atlaset gjør alt til ting, bare i koblingene."
      },
      "region": "v:words",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Grafen regner binært"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-30",
      "sources": [
