    {
      "@id": "n:the-east-divides",
      "@type": "v:Insight",
      "label": {
        "nb": "Østen svarer begge veier"
      },
      "text": {
        "nb": "På akkurat dette spørsmålet går de to store indiske tradisjonene hver sin vei. Upanishadene og Advaita lærer at selvet i hver enkelt og det som ligger under alt, er det samme. Da fantes det aldri en lytter som bare var hans, bare én som så ut gjennom ham. Buddhismen sier at det ikke finnes noe selv, men at bevissthetsstrømmen likevel er individuell og fortsetter som én strøm, en lampe tent av en annen. Det er altså ikke ett østlig svar, men to motsatte."
      },
      "region": "v:east",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Østen deler seg"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "answers": [
