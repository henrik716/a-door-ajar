        "n:where-the-individual-sits",
        "n:not-ruled-out-has-content"
      ]
    },
    {
      "@id": "n:must-the-bond-be-released",
      "@type": "v:Question",
      "label": {
        "nb": "Må båndet slippes?"
      },
      "text": {
        "nb": "Spørsmålet antar at et bånd er det samme som nærvær. Sorgforskningen har gått fra «gi slipp» til «behold båndet i ny form». Det som endrer seg, er hvor båndet bor."
      },
      "region": "v:grief",
      "answer": {
        "nb": "Nei, men det flytter"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "usesWord": [
