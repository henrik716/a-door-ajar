    {
      "@id": "n:bering-mouse",
      "@type": "v:Finding",
      "label": {
        "nb": "Musa og alligatoren"
      },
      "text": {
        "nb": "Barn så et dukketeater der en mus ble spist av en alligator. De var stort sett enige om at musa ikke lenger trengte mat, og at hjernen ikke virket. Men mange mente at den fortsatt var glad i mamma og visste ting. Med alderen trodde færre at kroppen fungerte, men følelsene og kunnskapen hang igjen lengst. Også voksne som selv sa at døden er slutten, svarte ofte at en mann som døde i en ulykke, visste at han var død."
      },
      "region": "v:blindspots",
      "strength": "v:supported",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "supports": [
        "n:simulation-limit"
      ]
    },
    {
      "@id": "n:besso-letter",
      "@type": "v:Image",
      "label": {
        "nb": "Brevet om Besso"
      },
      "text": {
        "nb": "Besso hadde forlatt denne rare verden litt før ham, skrev Einstein, og det betydde ingenting. En måned senere døde Einstein selv."
      },
      "region": "v:time",
      "strength": "v:image",
