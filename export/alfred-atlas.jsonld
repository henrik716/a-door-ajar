      ]
    },
    {
      "@id": "n:two-kinds-of-emptiness",
      "@type": "v:Insight",
      "label": {
        "nb": "Tomhet med noen der, og tomhet uten"
      },
      "text": {
        "nb": "Hvis beskrivelsene er troverdige, kan lesing uten tekst og ingen lesing skilles fra innsiden. Da er ren bevissthet ikke bare et hull i hukommelsen, for et slikt hull ville sett ut som opphøret. Og opphøret er ikke mørkt. Det er det samme som folk sier om narkose: tiden var bare borte."
      },
      "region": "v:consciousness",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "To slags tomhet"
      },
      "conversation": "v:deepdive",
