    {
      "@id": "n:now-is-real",
      "@type": "v:Position",
      "label": {
        "nb": "Nået er ekte"
      },
      "text": {
        "nb": "Smolin og Ellis mener at tiden er grunnleggende og at nået finnes i fysikken. Men de skiller lag om fortiden: for Smolin finnes bare nået, for Ellis finnes fortiden fortsatt. Spørsmålet er åpent også blant fysikere."
      },
      "region": "v:time",
