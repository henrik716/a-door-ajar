    {
      "@id": "n:anatta",
      "@type": "v:Position",
      "label": {
        "nb": "Ikke-selv (anatta)"
      },
      "text": {
        "nb": "Den buddhistiske læren om at selvet er en prosess og ikke en ting. Parfit oppdaget senere at Buddha hadde sagt mye av det samme, og la ved buddhistiske sitater i boka si."
      },
      "region": "v:self",
      "strength": "v:position",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "contradicts": [
        "n:t-deep-self"
      ],
      "challengesWord": [
        "n:word-i"
      ],
      "relatedTo": [
        "n:reductionism"
      ],
      "challengesDerived": [
        "n:soul-continues",
        "n:swinburne-soul"
      ],
