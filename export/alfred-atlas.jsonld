      ]
    },
    {
      "@id": "n:three-words-physics-lacks",
      "@type": "v:Insight",
      "label": {
        "nb": "Sorgspørsmålene er bygget av ordene fysikken mangler"
      },
      "text": {
        "nb": "Fysikken har ikke «jeg», «her» eller «nå». Opplevelsen har alle tre. Parfit handlet om jeget, bålet om hvor, blokkuniverset om nå. «Hvor er Alfred nå?» er et spørsmål stilt fra et perspektiv, om et perspektiv. Det kan være tilfeldig, men det ser ut som et spor."
      },
      "region": "v:words",
      "strength": "v:contested",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "De tre ordene fysikken mangler"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "relatedTo": [
