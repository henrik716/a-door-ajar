    },
    {
      "@id": "n:mental-time-travel",
      "@type": "v:Position",
      "label": {
        "nb": "Mest i et bredt nå"
      },
      "text": {
        "nb": "Hunder husker hendelser og forventer faste ting til faste tider, men det er lite som tyder på at de ser for seg en fjern fremtid. Suddendorf og Corballis mente at slik tidsreise i tankene er særlig menneskelig. Det er omstridt for andre dyr, men for hunder er sporene svake. Alfred levde trolig mer i nået enn oss, men ikke bare i nået."
      },
      "region": "v:dog",
      "strength": "v:position",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
        "Suddendorf og Corballis (2007), Behavioral and Brain Sciences"
      ],
      "answers": [
        "n:alfreds-own-side"
      ],
      "relatedTo": [
        "n:different-now"
      ],
      "leadsTo": [
        "n:no-death-ahead"
      ]
    },
    {
      "@id": "n:metzinger",
      "@type": "v:Thinker",
      "label": {
        "nb": "Thomas Metzinger"
      },
      "text": {
        "nb": "Tysk filosof."
      },
      "region": "v:consciousness",
