      ]
    },
    {
      "@id": "n:axial-age",
      "@type": "v:Position",
      "label": {
        "nb": "Aksetiden"
      },
      "text": {
        "nb": "Mellom 800 og 200 f.Kr. dukket lignende tanker opp i Kina, India, Hellas og Midtøsten, stort sett uavhengig av hverandre. En nyere forklaring er felles livsvilkår: byer, handel og mer velstand ga folk rom til å spørre om det samme. Da er likheten verken kontakt eller sannhet, men felles omstendigheter."
      },
      "region": "v:blindspots",
      "strength": "v:position",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
