    {
      "@id": "n:poverty-or-freedom",
      "@type": "v:Position",
      "label": {
        "nb": "Dyr dør ikke, de opphører"
      },
      "text": {
        "nb": "Heidegger mente at bare den som forholder seg til sin egen død, dør i full forstand. Dyr «verenden», de opphører. Han så det som en fattigdom. Rilke så det samme som en frihet. Samme observasjon, motsatt verdi, og kanskje er begge feil ord."
      },
      "region": "v:dog",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Fattigdom eller frihet"
      },
      "conversation": "v:deepdive",
