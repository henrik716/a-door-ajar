    {
      "@id": "n:awareness-without-me",
      "@type": "v:Finding",
      "label": {
        "nb": "Våkenhet uten «meg»"
      },
      "text": {
        "nb": "Metzinger samlet hundrevis av beskrivelser fra mediterende av den reneste formen for våkenhet de har kjent. Mange beskriver den uten noen følelse av at det er deres. Hvis det stemmer, kan lytteren finnes uten at den er gitt som «min», og da sitter det individuelle ikke i selve lytteren. Men beskrivelsene kommer fra levende, individuelle hjerner, og de ble husket av personen etterpå."
      },
      "region": "v:consciousness",
      "strength": "v:supported",
      "shortLabel": {
        "nb": "Våkenhet uten meg"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
