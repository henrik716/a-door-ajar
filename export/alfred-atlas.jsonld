    {
      "@id": "n:man-and-person",
      "@type": "v:Position",
      "label": {
        "nb": "Samme menneske, men ikke samme person"
      },
      "text": {
        "nb": "Locke skilte mellom mennesket, som er den levende organismen, og personen, som strekker seg så langt minnene når. Den som har glemt alt, er etter ham samme menneske, men ikke samme person. Mønstersynet bygger på personen, animalismen på mennesket. Hvordan vi behandler mennesker med demens, går mot Locke: vi regner dem som de samme."
      },
      "region": "v:self",
      "strength": "v:position",
      "shortLabel": {
