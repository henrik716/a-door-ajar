    {
      "@id": "n:pause-or-copy",
      "@type": "v:Question",
      "label": {
        "nb": "Hvor går grensen mellom pause og kopi?"
      },
      "text": {
        "nb": "En time med stille hjerne kjennes som ham. En ny hjerne bygget etter en skanning kjennes som en kopi. Imellom ligger en glidende rekke: hjernen frosset ned i hundre år og vekket igjen, hjernen tatt fra hverandre og satt sammen av sine egne deler, eller bygget opp igjen av de samme atomene etter at de var spredt. Fysikken sier at informasjonen om ham i prinsippet ikke forsvinner, bare spres. Et sted på denne rekken går ham over i en kopi, og Alfreds tilfelle ligger langt ute på den."
      },
      "region": "v:self",
      "shortLabel": {
        "nb": "Pause eller kopi?"
      },
      "answer": {
        "nb": "Den kjennes ved skanningen, der den ubrutte veien brytes"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "relatedTo": [
        "n:death-is-not-a-pause",
        "n:information-preserved",
        "n:reassembly",
        "n:bodily-resurrection"
      ],
      "challengesWord": [
        "n:word-same"
      ],
      "mayDissolveDerived": [
        "n:continue-as-himself"
      ]
    },
    {
      "@id": "n:pci",
      "@type": "v:Finding",
      "label": {
        "nb": "Et mål på om noen er der"
      },
      "text": {
        "nb": "Forskere gir hjernen et lite magnetisk dytt og måler hvor sammensatt ekkoet blir. Høyt i våken tilstand, i drømmesøvn og under ketamin, der folk har opplevelser uten å reagere. Lavt i dyp søvn og under vanlig narkose. Målet skiller på om noen er der, ikke på hva de opplever. Det er det nærmeste vi har en måling av selve lytteren, og det følger hvor samlet hjernen er."
      },
      "region": "v:consciousness",
      "strength": "v:solid",
      "shortLabel": {
        "nb": "Kompleksitetsmålet"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
