    },
    {
      "@id": "n:intuition-not-proof",
      "@type": "v:Insight",
      "label": {
        "nb": "Følelsen teller ikke, verken for eller mot"
      },
      "text": {
        "nb": "Følelsen av at han fortsatt må være glad i deg et sted, og følelsen av at han bare er borte i mørket, er begge formet av den samme grensen. Ingen av dem er et spor. At vi kan forklare hvor en følelse kommer fra, gjør den ikke usann, bare ubrukelig som bevis. Det som står igjen, er argumentene."
      },
      "region": "v:blindspots",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
