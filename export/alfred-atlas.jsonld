    {
      "@id": "n:t-thing-with-a-place",
      "@type": "v:Position",
      "label": {
        "nb": "Alfred var en ting som må ha et sted"
      },
      "text": {
        "nb": "Den stille forutsetningen bak «hvor er han?». Hvis han var mer en prosess enn en ting, faller spørsmålet. Men det finnes et tredje svar: at noe i ham tok imot, en lytter. Og det kan være alle tre: kroppen var en ting, livet en prosess, og innsiden kanskje noe som ble tatt imot. Da faller spørsmålet bare for de to første."
      },
      "region": "v:words",
      "strength": "v:contested",
      "shortLabel": {
        "nb": "Han var en ting med et sted"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "relatedTo": [
        "n:program-and-listener"
      ]
    },
    {
      "@id": "n:tears-at-reunion",
      "@type": "v:Finding",
      "label": {
        "nb": "Tårer ved gjensyn"
      },
      "text": {
        "nb": "Hunder får mer tårevæske når de gjenforenes med eieren sin enn med andre mennesker de kjenner."
      },
      "region": "v:dog",
      "strength": "v:supported",
      "conversation": "v:deepdive",
