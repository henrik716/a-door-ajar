        "n:not-ruled-out-has-content"
      ]
    },
    {
      "@id": "n:gone-from-your-now",
      "@type": "v:Insight",
      "label": {
        "nb": "«Borte nå» er sant fra ditt nå"
      },
      "text": {
        "nb": "Hvis nået er noe et perspektiv lager, er «Alfred er borte nå» sant fra ditt nå, men ikke et faktum om virkeligheten som helhet. Livet hans ligger et annet sted i tiden. Det gir ikke at opplevelsen hans fortsetter."
      },
      "region": "v:time",
      "strength": "v:position",
      "ownConclusion": true,
      "hopeLevel": [
        1
      ],
      "conversation": "v:deepdive",
