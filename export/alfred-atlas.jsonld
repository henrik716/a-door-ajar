    {
      "@id": "n:cessation",
      "@type": "v:Finding",
      "label": {
        "nb": "Opphør: et kutt, ikke mørke"
      },
      "text": {
        "nb": "Svært erfarne mediterende skiller mellom to ting. Ren bevissthet oppleves, som våkenhet uten innhold. Opphør oppleves ikke i det hele tatt: det merkes først etterpå, som et kutt i filmen. En grundig studie fra 2023 målte hjernen til en mediterende gjennom mange slike opphør."
      },
