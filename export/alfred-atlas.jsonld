    {
      "@id": "n:holobiont",
      "@type": "v:Question",
      "label": {
        "nb": "Hvor gikk grensen for Alfred som organisme?"
      },
      "text": {
        "nb": "Animalismen og linjen om det som er tent av ham, forutsetter begge at det er klart hvor dyret slutter. Biologien er mindre sikker. En kropp er også et samfunn av mikrober, og noen biologer mener at organismen er hele dette fellesskapet. Hunder og menneskene de bor med, deler mikrober på huden. Bakteriene i huset er selvsagt ikke ham, og å hente trøst i dem ville vært en kategorifeil. Verdien er en annen: animalismen kan ikke si at organismen er en skarp boks mens det psykologiske er uklart. Også i biologien var grensen rundt ham porøs og delt."
      },
      "region": "v:dog",
      "shortLabel": {
        "nb": "Holobionten"
      },
      "answer": {
        "nb": "Uskarp også i biologien"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
        "Song m.fl., Cohabiting family members share microbiota with one another and with their dogs, eLife (2013)",
        "Gilbert, Sapp og Tauber, A symbiotic view of life: we have never been individuals (2012)"
      ],
      "qualifies": [
        "n:animalism"
      ],
      "relatedTo": [
        "n:lit-by-him",
        "n:state-lives-outside",
        "n:thin-wall"
      ],
      "notes": [
        "v:qualifies n:animalism: grensen rundt organismen er uskarp"
      ],
      "qualifiesDerived": [
        "n:animalism-polarizes"
      ]
    },
