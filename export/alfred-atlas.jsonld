    {
      "@id": "n:having-been",
      "@type": "v:Position",
      "label": {
        "nb": "Å ha vært er den sikreste formen for å være"
      },
      "text": {
        "nb": "Det forgjengelige er bare mulighetene. Når noe er levd, er det reddet inn i fortiden, der ingenting er ugjenkallelig tapt og alt er ugjenkallelig bevart. Frankl mente at det å ha vært kanskje er den sikreste måten å være på. Tanken krever ingen bestemt fysikk, bare at fortiden ligger fast. Den gir nivå 1, ikke mer."
      },
      "region": "v:grief",
      "strength": "v:position",
      "hopeLevel": [
        1
      ],
      "shortLabel": {
        "nb": "Å ha vært"
      },
      "conversation": "v:deepdive",
