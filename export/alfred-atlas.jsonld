    {
      "@id": "n:rebirth-without-self",
      "@type": "v:Position",
      "label": {
        "nb": "Gjenfødsel uten selv"
      },
      "text": {
        "nb": "Tradisjonell buddhisme lærer at strømmen av bevissthet fortsetter i nye liv, også for dyr, men uten et selv som flytter. Verken den samme eller en annen. Det er en troslære, ikke noe som kan sjekkes, og mange moderne buddhister, som Stephen Batchelor, lar den ligge."
      },
