    {
      "@id": "n:nothing-is-a-wrong-word",
      "@type": "v:Insight",
      "label": {
        "nb": "Også «ingenting» er feil ord"
      },
      "text": {
        "nb": "Østen avviser utslettelse like hardt som en evig sjel. Fortvilelsen «han er bare ingenting nå» er også et standpunkt, og som visshet står det ikke sterkere enn trøsten. Som sannsynlighet gjør det det, gitt at hjernen lager opplevelsen. Den eldste versjonen av det kartet fant: ryddingen kutter begge veier."
      },
      "region": "v:east",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Også «ingenting» er feil ord"
      },
