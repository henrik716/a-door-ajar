    {
      "@id": "n:prelife",
      "@type": "v:Finding",
      "label": {
        "nb": "Før du ble til"
      },
      "text": {
        "nb": "Barn fra to kulturer i Ecuador, blant dem et urfolk uten tro på et liv før livet, mente at de fantes før de ble unnfanget: uten kropp, men med følelser og ønsker. Det tyder på at forestillingen ikke bare kommer av frykt for døden, for bakover i tid finnes det ingen frykt å dempe."
      },
      "region": "v:blindspots",
      "strength": "v:supported",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
