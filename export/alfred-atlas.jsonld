    {
      "@id": "n:dog-episodic-memory",
      "@type": "v:Finding",
      "label": {
        "nb": "Hunder husker hendelser"
      },
      "text": {
        "nb": "Hunder som så eieren gjøre noe, kunne gjenta det senere selv om de ikke visste at de skulle bli spurt. Det er et minne om en hendelse, ikke bare en innlært vane. Om de har følelsen av at det var dem som var der, vet ingen."
      },
      "region": "v:dog",
