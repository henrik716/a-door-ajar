    {
      "@id": "n:tradeoff",
      "@type": "v:Insight",
      "label": {
        "nb": "Du får ikke begge deler fullt ut"
      },
      "text": {
        "nb": "Enten er innsiden mønsteret, og da lever han delvis i deg, men det finnes ikke noe mer som kan være et annet sted. Eller er innsiden mer enn mønsteret, og da er den ikke i deg, men hva som skjer med den, er ukjent. Den svake versjonen av mønsteret står i begge grenene."
      },
      "region": "v:consciousness",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
