    {
      "@id": "n:inner-outer-bonds",
      "@type": "v:Finding",
      "label": {
        "nb": "Indre og ytre bånd"
      },
      "text": {
        "nb": "Bånd som bor innover, i verdier, vaner og indre samtaler, henger sammen med vekst etter tapet. Bånd som leter etter den døde som fysisk til stede, henger sammen med mer smerte når de varer lenge. Tidlig i sorgen er det ytre helt vanlig: det er hjernens kart som ikke er oppdatert ennå."
      },
      "region": "v:grief",
      "strength": "v:supported",
      "conversation": "v:deepdive",
