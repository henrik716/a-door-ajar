    {
      "@id": "n:questions-can-dissolve",
      "@type": "v:Position",
      "label": {
        "nb": "Spørsmål kan oppløses"
      },
      "text": {
        "nb": "Noen spørsmål blir aldri besvart, men forsvinner når man finner riktig ord. Det er håpet bak hele feil ord-tråden. Men det er juks å la det løse alt: noen spørsmål er godt stilt og likevel ubesvarte."
      },
      "region": "v:words",
