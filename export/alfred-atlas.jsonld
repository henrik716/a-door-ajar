    {
      "@id": "n:reader-without-notebook",
      "@type": "v:Question",
      "label": {
        "nb": "Finnes det en leser uten notatbok?"
      },
      "text": {
        "nb": "Kan noen være til stede uten minnene sine, eller uten noe innhold i det hele tatt? Tre steder å lete: en leser med nesten ingen notatbok, en leser uten noe innhold, og en leser uten hjerne. De to første har data fra levende hjerner. Det tredje har ingen data."
      },
      "region": "v:borderland",
      "status": "v:planned",
      "shortLabel": {
        "nb": "Leser uten notatbok?"
      },
      "answer": {
        "nb": "I levende hjerner: nesten"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "partOf": [
        "n:reader-is-the-question"
      ],
      "relatedTo": [
