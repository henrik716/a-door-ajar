      "@type": "v:Position",
      "label": {
        "nb": "Åpen individualisme"
      },
      "text": {
        "nb": "Det finnes bare ett subjekt, og det ser ut fra alle perspektivene. Den som så ut gjennom Alfreds øyne, er den samme som nå savner ham. Det som tok slutt, var et perspektiv, ikke et subjekt. Bevarer ikke Alfred som Alfred: minnene og båndene følger ikke med."
      },
      "region": "v:limits",
