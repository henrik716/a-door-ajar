    {
      "@id": "n:secure-base",
      "@type": "v:Finding",
      "label": {
        "nb": "Du var den trygge basen"
      },
      "text": {
        "nb": "Med metodene fra forskning på små barn og foreldre: hunder knytter seg til mennesket sitt som en trygg base. Når personen er der, utforsker de roligere. Når personen går, merker de det i hele kroppen."
      },
      "region": "v:dog",
      "strength": "v:solid",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
