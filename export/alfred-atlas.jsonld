    {
      "@id": "n:survive-as-spectators",
      "@type": "v:Image",
      "label": {
        "nb": "Vi overlever som tilskuere"
      },
      "text": {
        "nb": "Freud i 1915: vår egen død kan ikke forestilles, og hver gang vi prøver, merker vi at vi egentlig fortsatt er til stede som tilskuere. Det samme som Berings funn, sagt nesten hundre år før."
      },
      "region": "v:blindspots",
