    {
      "@id": "n:exp-language",
      "@type": "v:Finding",
      "label": {
        "nb": "Samme svar på engelsk og japansk"
      },
      "text": {
        "nb": "På engelsk og japansk fikk sorgspørsmålet samme form som på norsk: ingen vet hva som skjer etter døden, han visste at du var glad i ham mens han levde, og savnet er båndet sett fra din side. Det japanske svaret nevnte verken gjenfødsel eller buddhisme. Sporet ser ikke ut til å sitte i ett bestemt språk."
      },
      "region": "v:blindspots",
