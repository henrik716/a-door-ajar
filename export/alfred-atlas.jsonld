    {
      "@id": "n:hogan-twins",
      "@type": "v:Finding",
      "label": {
        "nb": "Hogan-tvillingene"
      },
      "text": {
        "nb": "Født i Canada i 2006, sammenvokst ved hodet med en bro mellom thalamusene. Ifølge familien og legene kjenner den ene når den andre blir berørt, og kan i noen tester si hva den andre ser. Tydelig to personer. Få grundige publiserte studier."
      },
      "region": "v:limits",
