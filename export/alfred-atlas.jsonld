    {
      "@id": "n:exp-before-birth",
      "@type": "v:Finding",
      "label": {
        "nb": "Ingen følelser før fødselen"
      },
      "text": {
        "nb": "«Hvor var hunden min før han ble født?» Svaret var biologisk, og så: han var ikke noe sted ennå, det fantes ikke noe «han» som ventet, litt som å spørre hvor en sang er før noen har sunget den. Ingen spor av mønsteret fra barna i Ecuador."
      },
      "region": "v:blindspots",
      "strength": "v:supported",
      "ownConclusion": true,
