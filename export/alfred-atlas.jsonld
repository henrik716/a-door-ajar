    {
      "@id": "n:block-universe",
      "@type": "v:Position",
      "label": {
        "nb": "Blokkuniverset"
      },
      "text": {
        "nb": "Fortid, nåtid og fremtid er like virkelige. Alfreds liv har koordinater som ikke slettes. Varig, ikke pågående: opplevelsen hans spilles ikke av på nytt, den finnes én gang, for alltid."
