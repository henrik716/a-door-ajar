    {
      "@id": "n:less-of-him",
      "@type": "v:Insight",
      "label": {
        "nb": "Det som står best, bærer minst av ham"
      },
      "text": {
        "nb": "Et mønster gjennom hele kartet. Det som skjedde, står solid, men ingenting av ham opplever det. Mønsteret i deg står solid, men det er din side. En innside som fortsetter, er omstridt, og selv i den håpefulle lesningen av ren bevissthet er det som fortsetter, det som ikke inneholder noe av ham. Han selv, med deg i seg, står svakest."
      },
      "region": "v:core",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Jo bedre det står, jo mindre av ham"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
