    {
      "@id": "n:short-selves",
      "@type": "v:Position",
      "label": {
        "nb": "Selvet varer bare en stund"
      },
      "text": {
        "nb": "Galen Strawson har argumentert for at det som opplever, kanskje bare varer så lenge en sammenhengende strekning av opplevelse varer, og at et nytt subjekt tar over etter hvert avbrudd. Da dør man litt hver natt, og den som våkner, arver minnene. Det er den sure konsekvensen hvis man holder fast på at det er selve opplevelsen som må være ubrutt. De fleste avviser den, men den viser hva som står på spill i pausespørsmålet."
      },
      "region": "v:self",
      "strength": "v:contested",
      "shortLabel": {
        "nb": "Korte selv"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
        "Galen Strawson, Selves (2009)"
      ],
      "relatedTo": [
        "n:pause-or-copy",
        "n:anesthesia-and-dreams"
      ],
      "contradicts": [
        "n:your-thoughts-on-carrier"
      ],
      "notes": [
        "v:contradicts n:your-thoughts-on-carrier: pausen er ikke overlevelse"
      ]
    },
    {
      "@id": "n:simple-death-concept",
      "@type": "v:Position",
      "label": {
        "nb": "Dyr kan forstå at døde ikke kommer tilbake"
      },
      "text": {
        "nb": "Monsó mener at et enkelt dødsbegrep er vanlig blant dyr: at noe som er dødt, ikke virker og ikke kommer tilbake. Det krever ikke ord eller religion. Men å forstå at man selv en gang skal dø, er noe helt annet, og det finnes ingen tegn til det hos hunder."
      },
      "region": "v:dog",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Et enkelt dødsbegrep"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "answers": [
        "n:alfreds-own-side"
      ],
      "leadsTo": [
        "n:no-death-ahead"
      ]
    },
    {
      "@id": "n:simply-gone",
      "@type": "v:Position",
      "label": {
        "nb": "Han er bare borte, punktum"
      },
      "text": {
        "nb": "Det vanlige moderne bildet, ofte tatt for å være det vitenskapelige. Det holdt ikke helt: «borte» er knyttet til et perspektiv, «hvor» er et tvilsomt ord, og ingen vet hva innsiden er."
      },
      "region": "v:core",
      "strength": "v:contested",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "presupposes": [
        "n:t-common-now",
        "n:t-sealed-minds"
      ],
      "usesWord": [
        "n:word-gone",
        "n:word-now"
      ]
    },
    {
      "@id": "n:simulation-limit",
      "@type": "v:Position",
      "label": {
        "nb": "Vi kan ikke forestille oss å ikke oppleve"
      },
      "text": {
        "nb": "Berings forklaring: å forestille seg noe er selv en opplevelse, så vi kan ikke forestille oss at ingenting oppleves. Sult og syn har vi kjent fraværet av, så de er lette å tenke bort. Å vite noe og å være glad i noen har vi aldri kjent fraværet av, så de blir hengende igjen når vi tenker oss døden."
      },
      "region": "v:blindspots",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Simuleringsgrensen"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "answers": [
        "n:true-track-or-blindspot"
      ],
      "leadsTo": [
