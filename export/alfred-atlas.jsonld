      ]
    },
    {
      "@id": "n:three-extremes",
      "@type": "v:Insight",
      "label": {
        "nb": "Tekst uten kjent leser, leser med lite tekst, leser uten tekst"
      },
      "text": {
        "nb": "Claude er tekst uten noen kjent leser: alt det gjør, har innhold, og ingen vet om noen opplever det. Alfred og Clive Wearing er lesere med lite tekst: til stede, med få ord eller få minner. Ren bevissthet er leseren uten tekst. Sammen viser de at innhold og opplevelse kan skilles i begge retninger."
      },
      "region": "v:blindspots",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Tre ytterpunkter"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "relatedTo": [
