    {
      "@id": "n:carrier-not-content",
      "@type": "v:Finding",
      "label": {
        "nb": "Personen er bæreren, ikke innholdet"
      },
      "text": {
        "nb": "Dine tanker: en person med demens er den samme personen, og det samme er en som er hjernevasket til å mene det stikk motsatte av før. Da er personen ikke innholdet, men bæreren av det. Du har heller aldri hatt tilgang til innholdet hans. Du så og opplevde ham fra din side og vet lite om hva som var der inne. Det du var glad i, møtte du altså ikke som innhold. Det passer med linjen din: hjernen hans i en ny hund er ham, en kopi med alle minnene er det ikke. Tanker underveis, ikke et svar."
      },
      "region": "v:self",
      "strength": "v:supported",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Bæreren, ikke innholdet"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-30",
      "supports": [
        "n:measured-by-content"
