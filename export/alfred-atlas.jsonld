    {
      "@id": "n:reductionism",
      "@type": "v:Position",
      "label": {
        "nb": "Ingen ekstra kjerne"
      },
      "text": {
        "nb": "Et liv består av en kropp og en lang kjede av ting som henger sammen: minner, vaner, forventninger, karakter. Det finnes ikke et dypt faktum i tillegg. Det kutter begge veier: ingen sjel som garantert venter, men heller ikke noe udelelig som ble knust i ett slag."
      },
      "region": "v:self",
      "strength": "v:position",
