    {
      "@id": "n:reader-is-reading",
      "@type": "v:Insight",
      "label": {
        "nb": "Kanskje er leseren lesingen"
      },
      "text": {
        "nb": "Bildet av en leser og en notatbok antar at leseren kan stå igjen når boka er borte. Hos Hume og Buddha finnes det ingen leser utenom lesingen. Da blir spørsmålet ikke om leseren overlever, men om det kan finnes lesing uten tekst. Det nærmeste vi har, er beskrivelsene av ren bevissthet, og de kommer fra levende hjerner."
      },
      "region": "v:borderland",
      "strength": "v:position",
      "ownConclusion": true,
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "qualifies": [
        "n:reader-is-the-question"
      ],
      "challengesWord": [
        "n:word-reader"
      ],
      "relatedTo": [
        "n:bundle-self",
        "n:anatta",
        "n:pure-awareness"
      ]
    },
    {
      "@id": "n:reader-is-the-question",
      "@type": "v:Insight",
      "label": {
        "nb": "Sporene kan overleve, leseren er spørsmålet"
      },
      "text": {
        "nb": "Hukommelsen deler seg i to, slik identitet og opplevelse gjorde. Sporene: hans indre spor av deg var et mønster i hjernen, og det mønsteret er borte i sin form. Noen spor finnes utenfor, i deg og i det du tok vare på, men det er din side. Leseren: den som husker, med følelsen av at det var ham. Det er det harde problemet igjen. Nivå 6, han selv med minnene, trenger begge. Det første er det sterkeste funnet mot håpet i hele kartet. Det andre er åpent."
      },
      "region": "v:borderland",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Leseren er spørsmålet"
      },
      "conversation": "v:deepdive",
