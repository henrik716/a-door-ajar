    {
      "@id": "n:objective-immortality",
      "@type": "v:Position",
      "label": {
        "nb": "Vei 3: Objektiv udødelighet"
      },
      "text": {
        "nb": "Hvert øyeblikk av opplevelse blir, når det er fullført, en varig del av virkeligheten. Hartshorne: alt vi opplevde, holdes for alltid i en kosmisk hukommelse. Alfreds kjærlighet til deg er bevart som noe som blir følt. Gir bevaring, ikke at han opplever videre."
      },
      "region": "v:borderland",
      "strength": "v:contested",
      "hopeLevel": [
        1,
        4
      ],
      "shortLabel": {
