    {
      "@id": "n:fechner-larger-life",
      "@type": "v:Position",
      "label": {
        "nb": "De døde lever videre i de levende og i en større bevissthet"
      },
      "text": {
        "nb": "Fysikeren og psykologen Fechner mente at når noen dør, slutter de å se og høre for jordas større bevissthet, som om et av verdens øyne lukkes. Men minnene og det de var, lever videre i den større helheten, like tydelig som før, og i de levende de har preget. William James skrev varmt om ham. Det er en av de tidligste tydelige versjonene av havet med vannet, og den knytter det sammen med mønsteret i deg."
      },
      "region": "v:limits",
      "strength": "v:contested",
      "hopeLevel": [
        2,
        4
      ],
      "shortLabel": {
        "nb": "Fechners større liv"
      },
