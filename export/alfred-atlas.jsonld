    {
      "@id": "n:hasker-emergent-mind",
      "@type": "v:Position",
      "label": {
        "nb": "Sinnet vokser fram av hjernen, men er noe eget"
      },
      "text": {
        "nb": "Hasker tar hjerneforskningen på alvor: sinnet oppstår av hjernen og avhenger av den, omtrent som et magnetfelt avhenger av det som lager det. Men når det først har oppstått, er det noe eget, som kan virke tilbake på hjernen. For at det skal overleve døden, mener han at Gud må holde det oppe. Det er et forsøk på å forene nivå 5 med hjernen, men det trenger noe utenfor naturen for å gå videre."
      },
      "region": "v:self",
      "strength": "v:contested",
      "hopeLevel": [
        5,
        6
      ],
      "shortLabel": {
        "nb": "Haskers fremvoksende sinn"
      },
      "conversation": "v:deepdive",
