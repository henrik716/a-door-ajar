      "@type": "v:Finding",
      "label": {
        "nb": "Han visste at du fantes"
      },
      "text": {
        "nb": "Hunder klarer tester der en gjenstand gjemmes. De vet at ting finnes når de er ute av syne. Alfred ventet fordi han visste at du var et sted."
      },
      "region": "v:dog",
