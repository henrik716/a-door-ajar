    {
      "@id": "n:fly-in-the-bottle",
      "@type": "v:Image",
      "label": {
        "nb": "Fluen i flaska"
      },
      "text": {
        "nb": "Wittgenstein sa at målet med filosofien er å vise fluen veien ut av fluefangerflaska. Fluen kommer seg ikke ut fordi den flyr mot glasset. Veien ut er der den kom inn."
      },
