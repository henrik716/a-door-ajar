    {
      "@id": "n:many-worlds",
      "@type": "v:Position",
      "label": {
        "nb": "Mange verdener"
      },
      "text": {
        "nb": "I Everetts tolkning av kvantemekanikken skjer alle mulige utfall, hvert i sin gren av virkeligheten. Da finnes det trolig greiner der Alfred fikk flere år. Men ingen gren har kontakt med en annen, og i hver av dem er det en annen versjon av deg som har ham. Det er Parfits deling i kosmisk skala, og det gir ingenting i denne grenen."
      },
      "region": "v:borderland",
      "strength": "v:position",
      "conversation": "v:deepdive",
