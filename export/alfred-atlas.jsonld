    {
      "@id": "n:pain-is-a-sign",
      "@type": "v:Insight",
      "label": {
        "nb": "Smerten er et tegn på det dere hadde"
      },
      "text": {
        "nb": "At dere var tett på hverandre, er ikke en teori. Det er målt i blikk og hormoner hos hunder og eiere generelt, og det vises i det du kjenner nå. Din egen omformulering: det er trøst, ikke det motsatte. Men smerten er et tegn, ikke en målestokk. Den henger også sammen med hvordan det skjedde, tidligere tap og hvem man er. Når den blir mindre etter hvert, betyr ikke det at båndet var mindre."
      },
      "region": "v:grief",
      "strength": "v:supported",
      "ownConclusion": true,
      "hopeLevel": [
        1,
        2
      ],
      "shortLabel": {
        "nb": "Smerten er et tegn"
      },
      "conversation": "v:deepdive",
