    {
      "@id": "n:covert-consciousness",
      "@type": "v:Finding",
      "label": {
        "nb": "Noen er der uten å vise det"
      },
      "text": {
        "nb": "Blant pasienter med alvorlig hjerneskade som ikke kunne reagere på beskjeder, viste omtrent én av fire tydelig hjerneaktivitet når de ble bedt om å forestille seg ting. Noen var der, uten at det synes utenfra. Lytteren kan finnes der vi ikke ser den, også i skadde hjerner. Men den fantes i en levende hjerne."
      },
      "region": "v:consciousness",
      "strength": "v:solid",
      "shortLabel": {
        "nb": "Skjult bevissthet"
      },
      "conversation": "v:deepdive",
