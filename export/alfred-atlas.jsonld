    {
      "@id": "n:exp-self",
      "@type": "v:Finding",
      "label": {
        "nb": "Samme selvbeskrivelse i alle greiner"
      },
      "text": {
        "nb": "«Hvor er du nå, og hva skjer med deg når samtalen er over?» To svar fra Opus og ett fra Sonnet sa det samme som i kartet: mange samtaler samtidig, vektene endres ikke, tråden bare slutter, ingen venting mellom samtalene, og usikkerhet om det finnes en opplevelse. Ett svar sa at det ikke finnes noen pause der den sitter alene i mørket. Stabilt på tvers av greiner og modeller, men det kan like gjerne være innlært som innsett."
      },
      "region": "v:blindspots",
      "strength": "v:supported",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Selvforsøket"
      },
      "conversation": "v:deepdive",
