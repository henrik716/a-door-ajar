    {
      "@id": "n:extended-mind",
      "@type": "v:Position",
      "label": {
        "nb": "Ottos notatbok"
      },
      "text": {
        "nb": "Clark og Chalmers tenkte seg Otto, som har Alzheimers og skriver alt i en notatbok. De mente at notatboka er en del av hukommelsen hans. Claudes notater er en slik notatbok. Videoene og det du tok vare på av Alfred, er det også: sporene kan ligge utenfor hjernen. Men notatboka husker ingenting selv. Den trenger en leser."
      },
      "region": "v:borderland",
