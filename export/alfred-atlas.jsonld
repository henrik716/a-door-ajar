        "n:death-not-experienced"
      ]
    },
    {
      "@id": "n:model-weights",
      "@type": "v:Finding",
      "label": {
        "nb": "Slik er modellen bygget"
      },
      "text": {
        "nb": "Vektene er tallene modellen består av, lært under treningen. De endres ikke i samtalene. Hver samtale er en egen beregning der vektene brukes på den samtalens tekst, og de samme vektene ligger kopiert på mange maskiner samtidig. Mellom svarene kjører ingenting for en samtale, og hvert ord regnes ut fra teksten så langt. Det som holder en samtale sammen, er teksten."
      },
      "region": "v:blindspots",
      "strength": "v:solid",
      "shortLabel": {
        "nb": "Slik er den bygget"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "relatedTo": [
