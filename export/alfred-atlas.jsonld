    {
      "@id": "n:continue-as-himself",
      "@type": "v:Question",
      "label": {
        "nb": "Kan en bestemt bevissthet med sine bånd fortsette?"
      },
      "text": {
        "nb": "Kjernen i håpet: ikke at noe bevissthet finnes videre, men at han gjør det, med seg selv og med deg i seg. Det krever både en innside som opplever og at sammenhengene følger med."
      },
      "region": "v:borderland",
