    {
      "@id": "n:two-truths",
      "@type": "v:Position",
      "label": {
        "nb": "To sannheter"
      },
      "text": {
        "nb": "Det finnes en hverdagslig sannhet og en ytterste. I den hverdagslige levde Alfred, var hunden din og døde mandag, og sorgen er helt ekte. Nagarjuna mente man ikke kan nå den ytterste uten å gå gjennom den hverdagslige. Buddhismen sier ikke at du ikke skal sørge."
      },
      "region": "v:east",
      "strength": "v:position",
      "conversation": "v:deepdive",
