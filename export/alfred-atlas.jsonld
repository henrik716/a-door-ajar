    {
      "@id": "n:time-and-consciousness",
      "@type": "v:Position",
      "label": {
        "nb": "Bevissthet og tid er kanskje ett mysterium"
      },
      "text": {
        "nb": "Fysikken har to hull av samme type: den forklarer ikke hvorfor noe oppleves, og den har ingen plass for nå. Begge finnes bare i opplevelsen. Kanskje er det ett hull. Få har gravd her, fordi fysikere sjelden tar bevissthet på alvor og filosofer sjelden fysikken. Kobler man blokkuniverset med at opplevelse er innsiden av det fysiske, trenger ikke de tretten årene å spilles av på nytt for å ha hatt en innside. Det finnes ingen lampe som reiser langs tidslinjen og slukker lyset bak seg. Men da må ordet «fortsatt» holdes unna."
      },
      "region": "v:time",
      "strength": "v:contested",
      "shortLabel": {
        "nb": "Tid og bevissthet: ett mysterium?"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "relatedTo": [
        "n:hard-problem",
        "n:word-now",
        "n:block-universe",
        "n:russellian-monism",
        "n:uji"
      ],
      "leadsTo": [
        "n:still-trap"
      ]
    },
