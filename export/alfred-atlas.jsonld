    {
      "@id": "n:sunyata",
      "@type": "v:Position",
      "label": {
        "nb": "Tomhet (sunyata)"
      },
      "text": {
        "nb": "Ingenting finnes på egen hånd. Alt oppstår i avhengighet av noe annet, også et selv. Nagarjuna advarte mot å gjøre tomheten til et nytt standpunkt: den er en medisin, ikke en lære å klamre seg til."
      },
      "region": "v:east",
