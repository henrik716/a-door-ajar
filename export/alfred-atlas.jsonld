    {
      "@id": "n:duplication-problem",
      "@type": "v:Insight",
      "label": {
        "nb": "Kjernen er at ingen kan være to steder"
      },
      "text": {
        "nb": "Informasjon kan kopieres, og da kan det bli to. Identitet kan ikke deles: to kan ikke være én. Williams brukte dette mot mønstersynet allerede i 1956. Parfit var enig i at identitet ikke kan dobles, og trakk den motsatte slutningen: da er det ikke identitet som betyr noe. Bærersynet unngår kopiene, men ikke helt: en hjerne har to halvdeler."
      },
      "region": "v:self",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Problemet er dobling"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
