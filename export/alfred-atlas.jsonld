    {
      "@id": "n:closed-physics",
      "@type": "v:Position",
      "label": {
        "nb": "Fysikken er lukket ved hjernens energier"
      },
      "text": {
        "nb": "Lovene for partikler og krefter ved de energiene som finnes i en hjerne, er svært godt testet. Hvis noe utenfra skulle styre nervecellene, måtte det være en kraft vi ennå ikke har målt, eller et smutthull vi ikke kjenner. Carroll mener at det utelukker en sjel eller et signal som påvirker hjernen utenfra. Mange fysikere er enige, men ikke alle filosofer."
      },
      "region": "v:consciousness",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Lukket fysikk"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
