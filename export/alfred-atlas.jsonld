    {
      "@id": "n:fish-trap",
      "@type": "v:Image",
      "label": {
        "nb": "Fiskefella"
      },
      "text": {
        "nb": "Fiskefella finnes for fiskens skyld. Når du har fisken, kan du glemme fella. Ord finnes for meningens skyld. Når du har meningen, kan du glemme ordene. Zhuangzi lurte på hvor han kunne finne en som hadde glemt ordene, så han kunne snakke med ham."
      },
      "region": "v:east",
