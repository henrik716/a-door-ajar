    {
      "@id": "n:scent-mirror",
      "@type": "v:Finding",
      "label": {
        "nb": "Luktspeilet"
      },
      "text": {
        "nb": "Hunder klarer ikke speiltesten med synet. Men i en luktversjon brukte de lengre tid på sin egen lukt når den var endret, enn på andres. De kjenner igjen seg selv, i lukt. Alfred hadde et slags jeg, bare ikke det vi ser i speilet."
      },
      "region": "v:dog",
      "strength": "v:supported",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
        "Horowitz (2017), Behavioural Processes"
      ],
