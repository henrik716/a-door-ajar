    {
      "@id": "n:presentism",
      "@type": "v:Position",
      "label": {
        "nb": "Presentisme"
      },
      "text": {
        "nb": "Bare nået finnes. Smolin er nærmest dette blant fysikerne. Fortiden finnes ikke lenger, men det er fortsatt sant at den var. Den eneste tidsteorien der Frankls «bevart» blir et bilde og ikke bokstavelig."
      },
