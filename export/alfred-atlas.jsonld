    {
      "@id": "n:two-filter-theories",
      "@type": "v:Insight",
      "label": {
        "nb": "Filterteorien er to teorier"
      },
      "text": {
        "nb": "Kartet har slått sammen to versjoner. Den ene sier at også minnene ligger utenfor hjernen, slik Bergson mente. Den treffes hardt av funnene om hukommelsen. Den andre sier bare at selve opplevelsen tas imot, mens minnene og innholdet lages i hjernen, slik James kan leses. Den treffes ikke av de samme funnene. Den gir ikke at han husker deg, men målt i opphav og ikke i innhold kan den gi at noe av ham fortsetter, slik en person med demens er seg selv."
      },
      "region": "v:borderland",
      "strength": "v:position",
      "ownConclusion": true,
      "hopeLevel": [
        5
      ],
      "shortLabel": {
        "nb": "To filterteorier"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "qualifies": [
