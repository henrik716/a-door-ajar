    {
      "@id": "n:who-is-someone",
      "@type": "v:Insight",
      "label": {
        "nb": "Hvem vi regner som noen, er en vane som flytter seg"
      },
      "text": {
        "nb": "Mange forholder seg til insekter og dyr som om det ikke er noen der. Descartes så dyr som maskiner. I dag er forskerne stort sett enige om at pattedyr har en innside, og New York-erklæringen fra 2024 kaller det en realistisk mulighet for alle virveldyr og mange virvelløse dyr, også insekter. Om maskiner har en innside, vet ingen. Grensen for hvem som er noen, har flyttet seg før. Alfred står på den siden av den der vi er sikrest."
      },
      "region": "v:blindspots",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Hvem som er noen"
      },
      "conversation": "v:deepdive",
