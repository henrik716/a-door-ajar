    {
      "@id": "n:relation-r",
      "@type": "v:Position",
      "label": {
        "nb": "Det som betyr noe er sammenhengene"
      },
      "text": {
        "nb": "Parfits relasjon R: psykologisk sammenheng, uansett hva som bærer den. Den gjør håpet om gjensyn presist. Det krever ikke en sjel, bare at sammenhengene fortsetter. Han krevde likevel en eller annen årsakssammenheng med originalen."
      },
      "region": "v:self",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Sammenhengene er det som teller"
