    {
      "@id": "n:indras-net",
      "@type": "v:Image",
      "label": {
        "nb": "Indras nett"
      },
      "text": {
        "nb": "Et uendelig nett med en juvel i hver knute, der hver juvel speiler alle de andre. Ingen juvel er en lukket boks, men hver har sin egen vinkel i kraft av plassen sin i nettet. Det er et bilde på at havet ikke må være en ansiktsløs suppe: Alfreds måte å være til stede på trengte ikke en mur rundt seg for å være hans."
      },
      "region": "v:east",
      "strength": "v:image",
      "hopeLevel": [
