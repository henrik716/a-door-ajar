    {
      "@id": "n:t-sealed-minds",
      "@type": "v:Position",
      "label": {
        "nb": "Hvert sinn er forseglet fra naturens side"
      },
      "text": {
        "nb": "Antakelsen under mye av fortvilelsen: vi er stengt inne hver for oss, og døden lukker bare en boks som alltid var lukket. Grenseforskningen svekker den."
      },
      "region": "v:limits",
