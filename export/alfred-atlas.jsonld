    {
      "@id": "n:dreamless-sleep",
      "@type": "v:Position",
      "label": {
        "nb": "Vitnet i den drømmeløse søvnen"
      },
      "text": {
        "nb": "I indisk filosofi finnes et gammelt argument: når du våkner og sier at du sov godt og ikke visste noe, må noen ha vært der og ikke visst noe. Andre indiske filosofer svarte at det bare er en slutning gjort etterpå. Moderne søvnforskere diskuterer igjen om bevisstheten virkelig forsvinner helt i dyp søvn."
      },
      "region": "v:east",
