      ]
    },
    {
      "@id": "n:ship-of-theseus",
      "@type": "v:Image",
      "label": {
        "nb": "Skipet til Theseus"
      },
      "text": {
        "nb": "Er det samme skip når alle plankene er byttet ut? Valpen for tretten år siden og den gamle hunden på terrassen var bundet sammen av overlappende dager, ikke av en kjerne som aldri endret seg."
      },
      "region": "v:self",
      "strength": "v:image",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "exampleOf": [
