    {
      "@id": "n:a-b-series",
      "@type": "v:Position",
      "label": {
        "nb": "A- og B-rekken"
      },
      "text": {
        "nb": "McTaggart skilte mellom to måter å ordne tid på. A-rekken er fortid, nåtid og fremtid, og den endrer seg hele tiden. B-rekken er før og etter, og den endrer seg aldri. At turen ved sjøen kom før mandag, er sant for alltid. Bare A-plassen flytter seg, fra nå til da. «Det som skjedde, kan ikke gjøres om» er en B-sannhet. Sorgsvarene som flyttet seg fra «nå» til «da», flyttet seg mot det som aldri endrer seg."
      },
      "region": "v:time",
      "strength": "v:position",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "supports": [
        "n:cannot-be-undone"
      ],
      "relatedTo": [
        "n:comfort-in-tense",
        "n:block-universe",
        "n:t-fixed-past"
      ],
      "challengesWord": [
        "n:word-now"
      ],
      "mayDissolveDerived": [
        "n:alfred-now",
        "n:vertiginous-question"
      ]
