    {
      "@id": "n:line-and-buddhism",
      "@type": "v:Insight",
      "label": {
        "nb": "Linjen din passer best med buddhismen"
      },
      "text": {
        "nb": "Av alle tradisjonene i kartet er det buddhismen som ligger nærmest det du har kjent i disse dagene: ingen fast kjerne, men en strøm som er tent av den forrige, lampe fra lampe, og som ikke tar minnene med seg. Den gjelder også dyr. Men den delen som sier at strømmen fortsetter etter døden, er en lære som ikke kan sjekkes, og mange moderne buddhister lar den ligge. Linjen din og tradisjonen passer sammen, men det gjør ikke tradisjonen mer sannsynlig."
      },
      "region": "v:east",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Linjen og buddhismen"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-30",
