    {
      "@id": "n:north-of-the-north-pole",
      "@type": "v:Image",
      "label": {
        "nb": "Nord for Nordpolen"
      },
      "text": {
        "nb": "Spørsmål som forutsetter en ramme som ikke holder: hva ligger nord for Nordpolen, hva skjedde før tiden begynte? «Er Alfred borte nå?» kan forutsette et nå som ikke er privilegert."
      },
      "region": "v:words",
      "strength": "v:image",
