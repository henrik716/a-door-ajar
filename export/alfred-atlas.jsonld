      ]
    },
    {
      "@id": "n:coexistence",
      "@type": "v:Finding",
      "label": {
        "nb": "To måter å tenke på i samme hode"
      },
      "text": {
        "nb": "Blant vezo-folket på Madagaskar sa voksne oftere at en død manns sinn fortsatte når historien handlet om forfedrene, enn når den handlet om kroppen. Lignende mønstre er funnet i flere land. Mennesker veksler mellom en biologisk og en åndelig måte å tenke på døden, uten å oppleve det som en motsigelse."
      },
      "region": "v:blindspots",
      "strength": "v:supported",
      "shortLabel": {
        "nb": "Begge deler i samme hode"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
