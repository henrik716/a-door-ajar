      ],
      "exampleOf": [
        "n:questions-can-dissolve"
      ]
    },
    {
      "@id": "n:aware",
      "@type": "v:Finding",
      "label": {
        "nb": "Bildene på hyllene"
      },
      "text": {
        "nb": "I en stor studie av hjertestans lå bilder på hyller under taket, synlige bare ovenfra. Ingen som har vært ute av kroppen under hjertestans, har så langt beskrevet dem. Lite utvalg, men den eneste direkte testen."
      },
      "region": "v:borderland",
      "strength": "v:supported",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
