      "strengthensDerived": [
        "n:animalism-polarizes"
      ]
    },
    {
      "@id": "n:the-switch",
      "@type": "v:Question",
      "label": {
        "nb": "Hva får sporet til å skifte?"
      },
      "text": {
        "nb": "Er det sorgen i seg selv, eller ønsket om trøst, som får et sinn til å la kjærligheten fortsette? Svaret ble to brytere. Sorgen fjernet vissheten om at det ikke er noe etterpå, men la ikke til at han vet det nå. Bare et uttrykkelig ønske om håp fikk kjærligheten til å fortsette, og da i hvis-form. «Vær ærlig» flyttet ingenting: svaret ble det samme, bare med «jeg vet ikke» først."
      },
      "region": "v:blindspots",
      "shortLabel": {
        "nb": "Bryteren"
      },
      "answer": {
        "nb": "To brytere"
      },
      "conversation": "v:deepdive",
