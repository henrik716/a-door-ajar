    {
      "@id": "n:split-brains",
      "@type": "v:Finding",
      "label": {
        "nb": "Splittede hjerner"
      },
      "text": {
        "nb": "Når forbindelsen mellom hjernehalvdelene kuttes, kan én hjerne oppføre seg som om den har to perspektiver. Omstridt: en studie fra 2017 fant delte sanser, men samlet bevissthet. Selv inne i én skalle er det ikke opplagt hvor veggen går."
      },
      "region": "v:limits",
      "strength": "v:supported",
