      ]
    },
    {
      "@id": "n:scent-clock",
      "@type": "v:Position",
      "label": {
        "nb": "Lukten av deg som klokke"
      },
      "text": {
        "nb": "Horowitz' hypotese: gjennom dagen blekner lukten av deg i huset, og hunden kan bruke det som klokke. Når lukten har falt til et visst nivå, er det på tide at du kommer. Ikke ordentlig testet."
      },
      "region": "v:dog",
      "strength": "v:contested",
      "shortLabel": {
