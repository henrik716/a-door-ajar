    {
      "@id": "n:clive-wearing",
      "@type": "v:Finding",
      "label": {
        "nb": "Clive Wearing"
      },
      "text": {
        "nb": "Britisk musiker som i 1985 fikk en hjernebetennelse og mistet nesten all hukommelse. Han husker bare sekunder om gangen og skrev i dagboka igjen og igjen at nå var han endelig våken. Men han kunne fortsatt spille og dirigere, og hver gang kona Deborah kom inn, hilste han henne med stor glede, som om hun hadde vært borte i årevis. Han var fortsatt til stede, og kjærligheten til henne overlevde."
      },
      "region": "v:borderland",
      "strength": "v:supported",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
