    {
      "@id": "n:awareness-as-ground",
      "@type": "v:Position",
      "label": {
        "nb": "Ren bevissthet er grunnen"
      },
      "text": {
        "nb": "Den andre lesningen: ren bevissthet er ikke noe hjernen lager, men det som ligger under alt. Upanishadene kaller det den fjerde tilstanden, bak våken, drøm og dyp søvn. Deler av buddhismen snakker om det lysende sinnet. Kastrup ville si at det er det som er igjen når veggene faller."
      },
      "region": "v:consciousness",
      "strength": "v:contested",
      "hopeLevel": [
        3
      ],
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
