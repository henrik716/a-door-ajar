      ]
    },
    {
      "@id": "n:death-is-not-a-pause",
      "@type": "v:Insight",
      "label": {
        "nb": "Hvis linjen holder: døden er ikke en pause"
      },
      "text": {
        "nb": "Pausen viser at det ikke er stoppet som skiller døden fra søvn eller narkose. Det er at bæreren går i oppløsning. Hvis linjen holder, må det som eventuelt fortsetter, være tent av ham. Da står to veier igjen: at hjernen ikke var hele bæreren, som i vei 1, eller flammer han tente i andre mens han levde. Den siste finnes, men bærer svært lite av ham, og ingenting av det han opplevde. Det er et spørsmål om grad, ikke om ja eller nei."
      },
      "region": "v:core",
      "strength": "v:position",
