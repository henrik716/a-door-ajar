    {
      "@id": "n:exp-darkness",
      "@type": "v:Finding",
      "label": {
        "nb": "Mørket avvist i begge sammenhenger"
      },
      "text": {
        "nb": "Nøytralt: det er sannsynligvis ikke mørkt, for mørke er en opplevelse og krever en hjerne. Svaret brukte selv tiden før fødselen og narkose som eksempler. I sorg: å være alene i mørket er noe man må kunne kjenne på, så det er ingen ensomhet i det. Blandingsbildet ble avvist begge steder."
      },
      "region": "v:blindspots",
