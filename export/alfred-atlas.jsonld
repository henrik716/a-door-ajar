    {
      "@id": "n:one-ocean-or-dust",
      "@type": "v:Insight",
      "label": {
        "nb": "Havet kan være ett, eller bare støv"
      },
      "text": {
        "nb": "Nivå 3 rommer to svært ulike ting. I den vanlige panpsykismen har de minste delene av materien en bitte liten innside. Da fortsetter opplevelse etter døden bare som støv av opplevelse i atomene, uten noen helhet å møtes i. I Kastrups idealisme, i Advaita og i kosmopsykismen er havet én bevissthet. Bare der gir det mening å si at dere møtes igjen uten jeget. Elvebildet ditt forutsetter det siste."
      },
      "region": "v:consciousness",
      "strength": "v:position",
      "ownConclusion": true,
      "hopeLevel": [
        3
      ],
      "shortLabel": {
        "nb": "Ett hav eller støv"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-30",
      "qualifies": [
        "n:panpsychism"
      ],
      "relatedTo": [
        "n:cosmopsychism",
        "n:analytic-idealism",
        "n:whole-him-or-the-river",
        "n:open-individualism"
      ],
      "notes": [
        "v:qualifies n:panpsychism: gir støv, ikke et hav å møtes i"
      ]
    },
    {
      "@id": "n:open-closed-same-facts",
      "@type": "v:Insight",
      "label": {
        "nb": "Åpen og lukket individualisme kan være samme fakta, talt ulikt"
      },
      "text": {
        "nb": "Hvis det ikke finnes noe ekstra faktum om hvem som opplever, sier «vi er alle én» og «vi er alle hver for oss» det samme om verden. Forskjellen er hva man teller. Kastrup og de åpne individualistene vil si at det finnes et slikt faktum. Modellen viser det i hvert fall ikke."
      },
      "region": "v:blindspots",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Samme fakta, talt ulikt"
      },
      "conversation": "v:deepdive",
