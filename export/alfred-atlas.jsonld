    {
      "@id": "n:clone-not-him",
      "@type": "v:Insight",
      "label": {
        "nb": "En klon ville ikke vært Alfred"
      },
      "text": {
        "nb": "Din egen konklusjon fra den første samtalen. Alle synene i kartet er enige her: en klon har genene, men verken minnene av deg, de tretten årene eller opphavet. Hvorfor det kjennes slik for deg, har vist seg å handle mer om opphavet enn om minnene."
      },
      "region": "v:self",
      "strength": "v:solid",
