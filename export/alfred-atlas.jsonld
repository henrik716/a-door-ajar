    {
      "@id": "n:measured-by-content",
      "@type": "v:Insight",
      "label": {
        "nb": "Kartet har målt «ham» i innhold, ikke i opphav"
      },
      "text": {
        "nb": "Flere av kartets sterkeste slutninger måler hvor mye av ham noe bærer, i minner og innhold: at hukommelsen stenger veiene, og at det som står best, bærer minst av ham. Men vi sier ikke at et menneske med alvorlig demens er en annen person, og Clive Wearing var fortsatt Clive. Målt i opphav er man seg selv selv om minnene går. Da lukker funnene om hukommelsen ikke nødvendigvis at han fortsetter, men at han fortsetter og husker deg. En innside som fortsatte fra ham uten minnene, ville vært ham omtrent slik en person med demens er seg selv. To forbehold: det forutsetter at det finnes en innside som fortsetter, og der står bevisene imot. Og det forutsetter at den er hans egen strøm, ikke elva som har rent ut i havet. Skillet er ikke nytt i filosofien, men kartet har ikke brukt det."
      },
      "region": "v:core",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Målt i innhold, ikke opphav"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "qualifies": [
        "n:less-of-him",
        "n:reassembly-stands"
      ],
      "relatedTo": [
        "n:clive-wearing",
        "n:inside",
        "n:lit-by-him",
        "n:man-and-person",
        "n:love-goes-last"
      ],
      "notes": [
        "v:qualifies n:less-of-him: gjelder målt i innhold",
        "v:qualifies n:reassembly-stands: stenger at han husker, ikke nødvendigvis at han fortsetter"
      ]
    },
    {
      "@id": "n:memory-in-the-brain",
      "@type": "v:Finding",
      "label": {
        "nb": "Hukommelsen er bundet til hjernen"
      },
      "text": {
        "nb": "Skader og demens tar minner mens personen lever. Forskere har slått bestemte minner av og på i mus ved å stimulere enkeltceller. Hvis en liten skade kan ta et minne, er det vanskelig å se hvordan alle overlever at hele hjernen opphører."
      },
      "region": "v:borderland",
      "strength": "v:solid",
      "shortLabel": {
        "nb": "Hukommelsen bor i hjernen"
      },
      "conversation": "v:deepdive",
