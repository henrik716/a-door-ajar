    {
      "@id": "n:growing-block",
      "@type": "v:Position",
      "label": {
        "nb": "Den voksende blokken"
      },
      "text": {
        "nb": "Fortiden og nået er virkelige, fremtiden finnes ennå ikke. Nået er kanten der virkeligheten vokser. Her ligger Alfreds tretten år inne i det som er virkelig, mens kanten flytter seg videre uten ham."
      },
      "region": "v:time",
      "strength": "v:position",
      "hopeLevel": [
        1
      ],
      "conversation": "v:deepdive",
