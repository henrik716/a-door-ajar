    {
      "@id": "n:true-track-or-blindspot",
      "@type": "v:Question",
      "label": {
        "nb": "Sporer de noe sant, eller deler vi blindsoner?"
      },
      "text": {
        "nb": "Nagasena og Ryle, Milinda og Parfit, Dōgen og Frankl kom fram til nesten det samme uten å kjenne hverandre. Enten sporer tankene noe som er sant, eller så deler menneskesinn de samme blindsonene. Kanskje begge deler. Det er ikke lett å vite om vi stiller feil spørsmål, eller om det er noe vi ikke er i stand til å se."
      },
      "region": "v:blindspots",
      "shortLabel": {
        "nb": "Sant spor eller felles blindsone?"
      },
      "answer": {
        "nb": "Delvis besvart"
      },
