    {
      "@id": "n:mineness",
      "@type": "v:Position",
      "label": {
        "nb": "Hver opplevelse er gitt som min"
      },
      "text": {
        "nb": "Zahavi mener at all opplevelse har en innebygd «for meg-het». Ikke et selv som eier opplevelsene, men at de alltid er gitt fra et perspektiv. Da sitter det individuelle i selve lytteren, ikke i innholdet. Hvis han har rett, var Alfreds lytter hans helt inn til kjernen."
      },
      "region": "v:consciousness",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Minheten"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
