    {
      "@id": "n:yudhishthira",
      "@type": "v:Image",
      "label": {
        "nb": "Kongen og hunden ved himmelporten"
      },
      "text": {
        "nb": "På slutten av Mahābhārata står kong Yudhishthira igjen med en hund som har fulgt ham hele veien. Indra vil ta kongen inn i himmelen, men ikke hunden. Kongen sier nei: han vil ikke inn i en himmel som krever at han svikter en som har vært trofast. Da viser hunden seg å være Dharma, selve rettferdigheten."
      },
      "region": "v:east",
      "strength": "v:image",
      "shortLabel": {
        "nb": "Hunden ved himmelporten"
      },
      "conversation": "v:deepdive",
      "created": "2026-11-01",
      "sources": [
        "Mahābhārata, bok 17 (Mahaprasthanika Parva)"
      ],
