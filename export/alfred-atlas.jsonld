    {
      "@id": "n:rainbow-bridge",
      "@type": "v:Image",
      "label": {
        "nb": "Regnbuebroen"
      },
      "text": {
        "nb": "En moderne fortelling om dyr som dør: de venter på en eng ved en bro, friske og glade igjen, til eieren kommer, og så går de over sammen. Ingen vet sikkert hvem som skrev den. Den er trolig vår tids vanligste svar på hvor et dødt dyr er, og den har nøyaktig Berings form: kroppen er frisk, men kjærligheten og ventingen fortsetter. Bildet av en lapphund som ligger og venter, som Claude brukte i den første samtalen, har samme form."
      },
      "region": "v:grief",
      "strength": "v:image",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
