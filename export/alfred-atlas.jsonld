      ]
    },
    {
      "@id": "n:carrier-view",
      "@type": "v:Position",
      "label": {
        "nb": "Bæreren må fortsette"
      },
      "text": {
        "nb": "En tredje posisjon mellom dyret og mønsteret. Det som avgjør, er at det som bærer sinnet, fortsetter: hjernen, eller de delene av den som lager bevisstheten. Hjernen kan flyttes til en ny kropp og fortsatt være deg, men en kopi av informasjonen er en ny bærer og dermed noen andre. McMahan kalte oss innkapslede sinn. Synet tar informasjonen på alvor uten å si at alt bare er informasjon: mønsteret er deg bare så lenge det er den samme bæreren som kjører det."
      },
      "region": "v:self",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Bærersynet"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
        "Jeff McMahan, The Ethics of Killing (2002)",
        "Peter Unger, Identity, Consciousness and Value (1990)"
      ],
