      ]
    },
    {
      "@id": "n:love-without-answer",
      "@type": "v:Insight",
      "label": {
        "nb": "Kjærligheten trenger ikke svaret"
      },
      "text": {
        "nb": "På en marsj i leiren snakket Frankl med kona i tankene, uten å vite om hun levde. Han beskrev at det på en måte sluttet å bety noe for kjærligheten. Du vet ikke om Alfred finnes et sted. Frankls erfaring tyder på at båndet ikke venter på at det spørsmålet blir besvart."
      },
      "region": "v:grief",
