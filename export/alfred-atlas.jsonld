    {
      "@id": "n:origin-matters",
      "@type": "v:Position",
      "label": {
        "nb": "Opphavet hører til tingen"
      },
      "text": {
        "nb": "Kripke argumenterte for at en ting ikke kunne hatt et annet opphav og fortsatt vært den samme tingen. Et bord laget av ett trestykke kunne ikke vært laget av et annet og vært det samme bordet. Opphavet er ikke bare historie om tingen, det er en del av hva den er. Tanken støtter at en kopi, uansett hvor lik, er en annen."
      },
      "region": "v:self",
      "strength": "v:position",
      "shortLabel": {
        "nb": "Opphavet hører til"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "sources": [
        "Saul Kripke, Naming and Necessity (1980)"
      ],
      "contradicts": [
