    {
      "@id": "n:cutaneous-rabbit",
      "@type": "v:Finding",
      "label": {
        "nb": "Kaninen på armen"
      },
      "text": {
        "nb": "To raske trykk, ett ved håndleddet og ett ved albuen, kan gi følelsen av trykk imellom som aldri skjedde. Hjernen skrev opplevelsen etter at det siste trykket kom."
      },
      "region": "v:time",
