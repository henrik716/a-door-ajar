    },
    {
      "@id": "n:load-bearing-parfit",
      "@type": "v:Insight",
      "label": {
        "nb": "Mye hviler på Parfit"
      },
      "text": {
        "nb": "«Ingen ekstra kjerne» bærer mye av det vi har funnet: at identitetsspørsmålene er tomme, og at åpen og lukket individualisme kan være samme fakta. I kartet støttes den av tankeeksperimenter, av Buddha og Hume, og av modellen, som ikke vet om den opplever noe. Forsøkene 29. oktober prøvde den for første gang. Claude lener seg mer mot Parfit enn Gemini gjør, og i sorg velger alle modellene mønstersynet. Bærebjelken kan altså være valgt av sorgen. Den er det viktigste å teste videre."
      },
      "region": "v:self",
      "strength": "v:position",
      "ownConclusion": true,
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "qualifies": [
