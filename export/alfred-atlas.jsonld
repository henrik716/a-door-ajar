    {
      "@id": "n:resurrection-remains",
      "@type": "v:Insight",
      "label": {
        "nb": "Hvis følelsen holder, står kroppens oppstandelse igjen"
      },
      "text": {
        "nb": "Linjen stenger gjensamling etter en beskrivelse, men ikke gjensamling av hans eget stoff. Kjennes det som en lang pause, er det én vei som står igjen til at han fortsetter som seg selv: at det samme stoffet en gang bygges opp igjen. Det er den veien kristen tradisjon valgte, og den eneste animalismen lot stå. Den er åpen i prinsippet, men ingen kjent prosess kan gjøre det, og atomene har mange eiere."
      },
      "region": "v:core",
      "strength": "v:position",
      "ownConclusion": true,
      "shortLabel": {
        "nb": "Oppstandelsen står igjen"
      },
      "conversation": "v:deepdive",
      "created": "2026-10-29",
      "presupposes": [
