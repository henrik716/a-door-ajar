      ]
    },
    {
      "@id": "n:memory-is-reconstruction",
      "@type": "v:Finding",
      "label": {
        "nb": "Å huske er å bygge på nytt"
      },
      "text": {
        "nb": "Bartlett viste i 1932 at folk gjenforteller historier ved å bygge dem opp på nytt, ikke ved å spille dem av. Senere forskning fant at et minne som hentes fram, blir formbart og lagres på nytt. Et minne er ikke et opptak, men noe som lages hver gang."
      },
      "region": "v:borderland",
      "strength": "v:solid",
      "conversation": "v:deepdive",
      "created": "2026-10-28",
      "sources": [
        "Bartlett (1932), Remembering",
        "Nader, Schafe og LeDoux (2000), Nature"
      ],
      "leadsTo": [
